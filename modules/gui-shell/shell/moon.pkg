// 系统能力壳层（NoahLiu/gui-shell，模块拆分之一）：菜单栏/右键菜单、全局
// 热键门面、托盘（SNI/Win32）、通知、外部打开、单实例——六条与控件树零
// 耦合的通道，只吃 base 常量、i18n 广播与 win/sys/dbus 三个能力模块后端。
// 全仓唯一同时 import 三个能力模块的层；不认识 widget（依赖方向是组件层
// 依赖 shell）。

supported_targets = "native"

import {
  "moonbitlang/core/encoding/utf8",
  "NoahLiu/gui-window/win",
  "NoahLiu/gui-sys/sys" @sys,
  "NoahLiu/gui-dbus/dbus" @dbus,
  "NoahLiu/gui-shell/i18n" @i18n,
}

// shell_stub.c 是单实例的 POSIX 套接字臂，只用标准头，直接走 native-stub，
// 无 prebuild、无新增链接参数。
options(
  "native-stub": [ "shell_stub.c" ],
)
