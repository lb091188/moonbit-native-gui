// 系统能力示例：本包只做装配——起窗、单实例声称、托盘单例与派发泵、语言切换；
// 共享层在 `shared/`，页面内容在 `pages/`。
import {
  "NoahLiu/native-gui/base",
  "NoahLiu/native-gui/widget" @widget,
  "NoahLiu/native-gui/shell" @shell,
  "NoahLiu/native-gui/dbus" @dbus,
  "NoahLiu/native-gui/ui",
  "NoahLiu/native-gui/icons",
  "NoahLiu/native-gui-examples-system/shared" @shared,
  "NoahLiu/native-gui-examples-system/pages" @pages,
}

pkgtype(kind: "executable")

supported_targets = "native"
