import {
  "NoahLiu/native-gui/base",
  "NoahLiu/native-gui/widget",
  "NoahLiu/native-gui/shell",
  "NoahLiu/native-gui/dbus",
  "NoahLiu/native-gui/ui",
  "NoahLiu/native-gui-examples-system/shared",
  "NoahLiu/native-gui-examples-system/pages",
}

pkgtype(kind: "executable")

supported_targets = "native"
