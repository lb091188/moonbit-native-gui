<script>
let count : @base.Store[Int] = @base.Store::new(0)
let name : @base.Store[String] = @base.Store::new("")

fn reset() {
  count.set(0)
  name.set("")
}
</script>
<template>
  <ui-col class="page">
    <ui-text class="title" text="你好，MoonBit 原生窗口" />
    <ui-text class="hint" text="上面是声明式页（hello.mng 单文件，改字可 mng dev 热更）；下面是命令式代码的基本窗口示例。" />
    <ui-input v-model="name" placeholder="你的名字" width="240.0" />
    你好, {{ name }}！
    <ui-stepper v-model="count" max="10" />
    计数: {{ count }}
    <ui-button text="重置" @click="reset" />
  </ui-col>
</template>
<style>
  .page {
    padding: 20px;
    row-gap: 8px;
    align-items: center;
  }
  .title {
    font-size: 18px;
    font-weight: bold;
  }
  .hint {
    font-size: 12px;
    color: var(--text_secondary);
  }
