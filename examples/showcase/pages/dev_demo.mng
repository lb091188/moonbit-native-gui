<script setup lang="moonbit">
let qty : @base.Store[Int] = @base.Store::new(3)
let wifi : @base.Store[Bool] = @base.Store::new(true)
let nick : @base.Store[String] = @base.Store::new("")

fn on_reset() {
  qty.set(3)
  nick.set("")
}
</script>
<template>
  <ui-col class="demo" row_gap="8.0">
    <ui-text class="demo-title" :text='@shared.tx("字号示例 20px")' />
    <ui-checkbox :label='@shared.tx("自动开启")' v-model="wifi" />
    <ui-text v-if="wifi" :text='@shared.tx("已开启")' />
    <ui-text v-else text="已关闭" />
    <ui-stepper v-model="qty" max="10" />
    当前数量：{{ qty }}
    <ui-input v-model="nick" placeholder="试试结构热更" />
    <ui-button text="重置" @click="on_reset" />
  </ui-col>
</template>
<style>
  /* 类槽只作用于挂它的那个控件——Style 没有继承，字号要挂在文字元素自己的类上 */
  .demo-title {
    font-size: 20px;
    font-weight: bold;
    color: var(--text_primary);
  }
  .demo {
    justify-content: center;
    align-items: flex-start;
  }
</style>
