  "\"seg.虚线\" = \"Dashes\"\n" +
  "\"set_dashes 图案与相位\" = \"set_dashes pattern and phase\"\n" +
  "\"desc§set_dashes 图案与相位\" = \"set_dashes(pattern, offset) takes alternating on/off segment lengths in logical pixels and a phase offset; an empty array goes back to a solid line. The three rows are [10, 6], the same pattern at offset 8, and a cleared pattern - the second row is shifted 8px with the same segment count. Dashes live in save/restore, so nested drawing does not leak. The pure raster backend only records state (the stroke still lands); Cairo is where the line really breaks.\"\n" +
  "\"同一图案，offset = 8\" = \"Same pattern, offset = 8\"\n" +
  "\"set_dashes([]) 回实线\" = \"set_dashes([]) back to solid\"\n" +
  "\"seg.裁剪与变换\" = \"Clip & transform\"\n" +
  "\"desc§clip_rect / translate / rotate / scale\" = \"The left block clips to a 140x140 rect first, then paints circles and lines far past it - everything outside is cut flat at the boundary. The right block translates the origin, rotates 20 degrees and scales 1.6x, one rounded rect each. All three mutate the current transform, so they must be wrapped in save/restore or every later draw inherits them.\"\n" +
  "\"clip_rect(24, 40, 140, 140)\" = \"clip_rect(24, 40, 140, 140)\"\n" +
  "\"translate + rotate(20°) / scale(1.6)\" = \"translate + rotate(20°) / scale(1.6)\"\n" +
  "\"seg.圆角与合成\" = \"Corners & alpha\"\n" +
  "\"圆角半径、抗锯齿与整层 alpha\" = \"Radii, anti-aliasing and whole-layer alpha\"\n" +
  "\"desc§圆角半径、抗锯齿与整层 alpha\" = \"The top row is three identical blocks with radii 0 / 8 / 24: corners are real arcs with 1px anti-aliasing, so no stair-stepping on the curve; turning the corner switch in the sidebar off falls back to square corners. The bottom row is set_global_alpha: the same circles drawn twice, the right pair at 35% - alpha multiplies at draw time rather than lightening a colour, so overlaps darken on their own.\"\n" +
  "\"圆角 0 / 8 / 24（真圆弧 + 1px 抗锯齿）\" = \"Radii 0 / 8 / 24 (real arcs, 1px anti-aliasing)\"\n" +
  "\"右边两个：set_global_alpha(0.35)\" = \"Right pair: set_global_alpha(0.35)\"\n" +
  "\"seg.位图\" = \"Bitmaps\"\n" +
  "\"PNG / JPEG / GIF 首帧与缩放\" = \"PNG / JPEG / GIF first frame and scaling\"\n" +
  "\"desc§PNG / JPEG / GIF 首帧与缩放\" = \"Image::new_from_file decodes PNG / JPEG / GIF (animated GIFs give the first frame here; playback is on the transition page) and draw_image scales it into a target rect. The same PNG is drawn at two sizes plus the first frame of a GIF: scaling is bilinear and the aspect ratio follows the target rect.\"\n" +
  "\"PNG 64×64 / 128×128，GIF 首帧取左上 20×20 放大到 80\" = \"PNG at 64x64 / 128x128; GIF first frame, top-left 20x20 scaled to 80\"\n" +
  "\"缩放不糊边\" = \"Scaling stays clean\"\n" +
  "\"字距 0：MoonBit GUI 字距对照\" = \"Spacing 0: MoonBit GUI letter spacing\"\n" +
  "\"字距 4：MoonBit GUI 字距对照\" = \"Spacing 4: MoonBit GUI letter spacing\"\n" +
  "\"desc§Line 折线图\" = \"Fixed-size scrolling window (120 pts) pushed every 500ms; line and area forms with auto scale, grid and latest label.\"\n" +
  "\"desc§Bar 柱状图 / 条形图\" = \"Vertical bars with +/- around zero, or horizontal for long categories; hover highlight and value labels.\"\n" +
  "\"desc§Donut 环形图\" = \"Proportional sectors from 12 o'clock, center total and a synced legend.\"\n" +
  "\"desc§Gauge 仪表盘\" = \"A percentage ring with threshold coloring; auto triangle wave on the left, slider-driven on the right.\"\n" +
  "\"desc§Scatter 散点图\" = \"2000 points with dual-axis ticks, grid and a least-squares trend line.\"\n" +
  "\"desc§扩展图表（六种）\" = \"Radar / heatmap / kline / funnel / boxplot / sankey with built-in demo data.\"\n" +
  "\"desc§新图表（八种）\" = \"Graph / parallel / pictorial bar / sunburst / theme river / tree / treemap / effect scatter with built-in data.\"\n" +
  "\"desc§交互图表\" = \"Interactive line/bar with wheel zoom and drag pan; all three have tooltips and clickable legends.\"\n" +
  "\"desc§CodeView 代码高亮\" = \"Per-token measured highlighting across platforms for many languages, plus line numbers.\"\n" +
  "\"desc§Markdown 渲染\" = \"mdast parse + rich-line drawing: headings, lists, code, tables, footnotes, tasks and emoji.\"\n" +
  "\"desc§Tag 标签、Avatar 头像与 Badge 徽标\" = \"Five semantic tags plus custom fills; square avatars in four sizes; numeric and dot badges.\"\n" +
  "\"desc§Statistic 数值统计与 Progress 进度条\" = \"A static statistic snapshot and a themed progress bar, wired to the basics-page signal.\"\n" +
  "\"desc§Card 卡片与 Collapse 折叠面板\" = \"Card with header and divider; collapse panels expand independently, first open.\"\n" +
  "\"desc§Descriptions 与 Timeline\" = \"A key/value grid; timeline with colored dots and a connecting line.\"\n" +
  "\"desc§Table 表格（单选与多选）\" = \"Zebra rows, resizable columns, sortable headers; single-select rebuilds via Store, multi-select with a checkbox column.\"\n" +
  "\"desc§Table 虚拟滚动\" = \"Only visible rows are drawn for smooth ten-thousand-row tables, with sorting and resizing.\"\n" +
  "\"desc§Tree 树形控件\" = \"Indented levels with expand/collapse.\"\n" +
  "\"desc§Transfer 穿梭框与 Carousel 轮播\" = \"Transfer rows between sides; carousel with arrows/dots and 3s auto-advance (pause on hover).\"\n" +
  "\"desc§Empty 空状态\" = \"A placeholder image with caption.\"\n" +
  "\"desc§吸顶分组列表\" = \"Group headers stick on scroll, showing the current group derived each frame from layout.\"\n" +
  "\"desc§指针事件 PointerEvent\" = \"Five pointer events share one on_pointer with local coordinates; double-click threshold 400ms/4px.\"\n" +
  "\"desc§悬停态与 on_hover_change\" = \"Hover is host-maintained with parent-chain semantics; the panel gets on_hover_change to start/stop a stopwatch.\"\n" +
  "\"desc§按下捕获（宿主内置规则）\" = \"No explicit capture API: from press to release all Move/Up go to the pressed widget, even outside its rect.\"\n" +
  "\"desc§光标形状 Cursor\" = \"w.cursor requests a shape; the host dispatches the deepest nonzero request along the hover path.\"\n" +
  "\"desc§键盘事件 KeyEvent\" = \"Keys go only to the focused widget; press-only, Tab/Shift+Tab drive focus. ev.mods carries modifiers.\"\n" +
  "\"desc§嵌套布局与三种宽度\" = \"Fixed/percent/flex widths; an 8px handle resizes the split (min 120/80) using press capture.\"\n" +
  "\"desc§Widget.on_double_click / on_triple_click / App::bind_combo\" = \"Attach multi-click handlers or bind combos/keys via App::bind_combo / bind_key_double.\"\n" +
  "\"desc§Alert 提示横幅\" = \"Four semantic types with a colored bar and tint; the last is closable with an optional on_close.\"\n" +
  "\"desc§Result 结果页\" = \"A large semantic glyph, title and description in four types.\"\n" +
  "\"desc§Popover 气泡弹层\" = \"Wrap any node to toggle a popover of arbitrary content.\"\n" +
  "\"desc§Toast 轻提示\" = \"Transient top-center toasts that auto-dismiss in 2.6s and stack.\"\n" +
  "\"desc§Dialog 对话框\" = \"A modal mask and centered panel, Store-driven, triggered from this page.\"\n" +
  "\"desc§自绘消息框\" = \"A self-drawn message box (same on all platforms) alongside the native one, with numbered buttons.\"\n" +
  "\"desc§输入框与多行\" = \"Store-driven single-line input (password masking) and an auto-wrapping multiline textarea.\"\n" +
  "\"desc§步进器 / 滑杆 / 评分\" = \"Stepper 0..10, slider with quantized thumb, five-star rate; values live in Stores.\"\n" +
  "\"desc§Select 与 ColorPicker\" = \"A clearable dropdown with hover/check marks and a preset color picker; values live in Stores.\"\n" +
  "\"desc§Checkbox / Radio / Switch\" = \"Check and switch values are the Stores themselves; radio groups are mutually exclusive.\"\n" +
  "\"desc§日期与时间选择\" = \"A self-drawn calendar with month paging plus date/datetime range pickers; values live in Stores.\"\n" +
