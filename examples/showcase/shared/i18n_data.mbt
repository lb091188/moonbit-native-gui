  // —— 段描述（desc§标题）——
  "\"desc§Transition 状态桶插值\" = \"Three cards differ only by transition_ms; hover animates bg/border/radius/text and reverses smoothly. Time-based, so dropped frames never speed it up.\"\n" +
  "\"desc§哪些属性会渐变\" = \"Hover fades the left card; the right also grows its font size. Color, border width, radius, font size and line height animate; opacity/shadow do not.\"\n" +
  "\"desc§样式槽里的文本字段\" = \"text_align, white_space, line_height and text_decoration are draw-time attributes applied via class.\"\n" +
  "\"desc§GIF 动图\" = \"A GIF component ticking by per-frame delay, with pause/resume and frame count.\"\n" +
  "\"desc§圆角与柔焦\" = \"Two global toggles: square corners zeroes every styled radius; soft blur samples and blurs the pixels behind a glass panel.\"\n" +
  "\"desc§主题色板\" = \"Pick an accent and the whole palette derives via HSL; follow-system reads OS accent with a built-in fallback.\"\n" +
  "\"desc§Button 按钮\" = \"Four variants; the primary button drives the data page counter via a signal.\"\n" +
  "\"desc§Label 与 Link\" = \"Five typography roles; links underline on hover and echo the last click.\"\n" +
  "\"desc§Divider 与 Tooltip\" = \"Horizontal/vertical 1px themed dividers; tooltip wraps any node with a native hint.\"\n" +
  "\"desc§HoverGroup 悬停组与 CursorGroup 光标组\" = \"Hover anywhere in a group (incl. children) highlights the whole card; cursor group keeps the hand cursor across its children.\"\n" +
  "\"desc§Painter 自绘\" = \"fill_rect/arc/fill/stroke_rect/draw_text plus linear gradients, drawn at the widget's real size.\"\n" +
  "\"desc§富文本 AttributedText\" = \"Range fonts/colors, wrap & ellipsis toggles, and text rewriting that keeps attributes.\"\n" +
  "\"desc§字体回退与混排行高\" = \"The right box swaps a suffix to 28px; both boxes take mixed line-height. Missing families fall back via resolve_family.\"\n" +
  "\"desc§端点/拐角与 Path 对象直通\" = \"set_line_cap/join map straight to Cairo; draw_path replays a recorded path in one go.\"\n" +
  "\"desc§Line 折线图\" = \"Fixed-size scrolling window (120 pts) pushed every 500ms; line and area forms with auto scale, grid and latest label.\"\n" +
  "\"desc§Bar 柱状图 / 条形图\" = \"Vertical bars with +/- around zero, or horizontal for long categories; hover highlight and value labels.\"\n" +
  "\"desc§Donut 环形图\" = \"Proportional sectors from 12 o'clock, center total and a synced legend.\"\n" +
  "\"desc§Gauge 仪表盘\" = \"A percentage ring with threshold coloring; auto triangle wave on the left, slider-driven on the right.\"\n" +
  "\"desc§Scatter 散点图\" = \"2000 points with dual-axis ticks, grid and a least-squares trend line.\"\n" +
  "\"desc§扩展图表（六种）\" = \"Radar / heatmap / kline / funnel / boxplot / sankey with built-in demo data.\"\n" +
  "\"desc§新图表（八种）\" = \"Graph / parallel / pictorial bar / sunburst / theme river / tree / treemap / effect scatter with built-in data.\"\n" +
  "\"desc§交互图表\" = \"Interactive line/bar with wheel zoom and drag pan; all three have tooltips and clickable legends.\"\n" +
  "\"desc§CodeView 代码高亮\" = \"Per-token measured highlighting across platforms for many languages, plus line numbers.\"\n" +
  "\"desc§Markdown 渲染\" = \"mdast parse + rich-line drawing: headings, lists, code, tables, footnotes, tasks and emoji.\"\n" +
  "\"desc§Tag 标签、Avatar 头像与 Badge 徽标\" = \"Five semantic tags plus custom fills; square avatars in four sizes; numeric and dot badges.\"\n" +
  "\"desc§Statistic 数值统计与 Progress 进度条\" = \"A static statistic snapshot and a themed progress bar, wired to the basics-page signal.\"\n" +
  "\"desc§Card 卡片与 Collapse 折叠面板\" = \"Card with header and divider; collapse panels expand independently, first open.\"\n" +
  "\"desc§Descriptions 与 Timeline\" = \"A key/value grid; timeline with colored dots and a connecting line.\"\n" +
  "\"desc§Table 表格（单选与多选）\" = \"Zebra rows, resizable columns, sortable headers; single-select rebuilds via Store, multi-select with a checkbox column.\"\n" +
  "\"desc§Table 虚拟滚动\" = \"Only visible rows are drawn for smooth ten-thousand-row tables, with sorting and resizing.\"\n" +
  "\"desc§Tree 树形控件\" = \"Indented levels with expand/collapse.\"\n" +
  "\"desc§Transfer 穿梭框与 Carousel 轮播\" = \"Transfer rows between sides; carousel with arrows/dots and 3s auto-advance (pause on hover).\"\n" +
  "\"desc§Empty 空状态\" = \"A placeholder image with caption.\"\n" +
  "\"desc§吸顶分组列表\" = \"Group headers stick on scroll, showing the current group derived each frame from layout.\"\n" +
  "\"desc§指针事件 PointerEvent\" = \"Five pointer events share one on_pointer with local coordinates; double-click threshold 400ms/4px.\"\n" +
  "\"desc§悬停态与 on_hover_change\" = \"Hover is host-maintained with parent-chain semantics; the panel gets on_hover_change to start/stop a stopwatch.\"\n" +
  "\"desc§按下捕获（宿主内置规则）\" = \"No explicit capture API: from press to release all Move/Up go to the pressed widget, even outside its rect.\"\n" +
  "\"desc§光标形状 Cursor\" = \"w.cursor requests a shape; the host dispatches the deepest nonzero request along the hover path.\"\n" +
  "\"desc§键盘事件 KeyEvent\" = \"Keys go only to the focused widget; press-only, Tab/Shift+Tab drive focus. ev.mods carries modifiers.\"\n" +
  "\"desc§嵌套布局与三种宽度\" = \"Fixed/percent/flex widths; an 8px handle resizes the split (min 120/80) using press capture.\"\n" +
  "\"desc§Widget.on_double_click / on_triple_click / App::bind_combo\" = \"Attach multi-click handlers or bind combos/keys via App::bind_combo / bind_key_double.\"\n" +
  "\"desc§Alert 提示横幅\" = \"Four semantic types with a colored bar and tint; the last is closable with an optional on_close.\"\n" +
  "\"desc§Result 结果页\" = \"A large semantic glyph, title and description in four types.\"\n" +
  "\"desc§Popover 气泡弹层\" = \"Wrap any node to toggle a popover of arbitrary content.\"\n" +
  "\"desc§Toast 轻提示\" = \"Transient top-center toasts that auto-dismiss in 2.6s and stack.\"\n" +
  "\"desc§Dialog 对话框\" = \"A modal mask and centered panel, Store-driven, triggered from this page.\"\n" +
  "\"desc§自绘消息框\" = \"A self-drawn message box (same on all platforms) alongside the native one, with numbered buttons.\"\n" +
  "\"desc§输入框与多行\" = \"Store-driven single-line input (password masking) and an auto-wrapping multiline textarea.\"\n" +
  "\"desc§步进器 / 滑杆 / 评分\" = \"Stepper 0..10, slider with quantized thumb, five-star rate; values live in Stores.\"\n" +
  "\"desc§Select 与 ColorPicker\" = \"A clearable dropdown with hover/check marks and a preset color picker; values live in Stores.\"\n" +
  "\"desc§Checkbox / Radio / Switch\" = \"Check and switch values are the Stores themselves; radio groups are mutually exclusive.\"\n" +
  "\"desc§日期与时间选择\" = \"A self-drawn calendar with month paging plus date/datetime range pickers; values live in Stores.\"\n" +
  "\"desc§Form 表单\" = \"form_item rows with right-aligned labels plus form group headings.\"\n" +
  "\"desc§表单与表格\" = \"MES form controls: input, select, tree, table and tabs.\"\n" +
  "\"desc§编辑与排版\" = \"Font styles, alignment, indent, undo/redo and save.\"\n" +
  "\"desc§方向与翻页\" = \"Arrows, collapse triangles, back-to-top, swap and drag.\"\n" +
  "\"desc§布局与视图\" = \"Grid, borders, radius, layers, distribution and zoom.\"\n" +
  "\"desc§文件与文档\" = \"Files, folders, documents, books and IDs.\"\n" +
  "\"desc§云与运维\" = \"Cloud sync, gateway, cluster, database, barcode and links.\"\n" +
  "\"desc§设备与硬件\" = \"Laptop, phone, tablet, printer, camera and peripherals.\"\n" +
  "\"desc§图表与数据\" = \"Line, bar, pie, radar, gauge and analysis.\"\n" +
  "\"desc§通信与消息\" = \"Messages, mail, notifications, calls, share and support.\"\n" +
  "\"desc§用户与团队\" = \"Users, teams, add/remove members, gender and occupation.\"\n" +
  "\"desc§安全与锁定\" = \"Lock, key, visibility, certificate and scan.\"\n" +
  "\"desc§时间与日历\" = \"Clock, timer, calendar, loading and sync.\"\n" +
  "\"desc§状态与反馈\" = \"Check/cross, ring states, emoji, like, favorite and power.\"\n" +
  "\"desc§金融与商业\" = \"Currency, wallet, bank, shopping, trophy and membership.\"\n" +
  "\"desc§系统与工具\" = \"Login/logout, import/export, settings, filter and build.\"\n" +
  "\"desc§天气与饮食\" = \"Weather glyphs, drinks, food and tableware.\"\n" +
  "\"desc§媒体与出行\" = \"Images, media, ball sports, transport and location.\"\n" +
  "\"desc§品牌与平台\" = \"Platforms, social and cloud vendor marks.\"\n" +
  "\"desc§其他\" = \"MES business and misc icons (pinyin-named).\"\n" +
  "\"desc§Side Menu 侧边导航\" = \"This very sidebar: collapsible groups, light-blue selection with accent bar.\"\n" +
  "\"desc§右键菜单、下拉菜单与原生菜单栏\" = \"Context menu wraps any node; dropdown expands candidates; native menu bar shown structurally.\"\n" +
  "\"desc§Segmented 分段控制器\" = \"Top-bar navigation sharing the same Store as the sidebar, so clicking really switches pages.\"\n" +
  "\"desc§Tabs 页签\" = \"Top tabs with an accent indicator; children are prebuilt and toggled by visibility.\"\n" +
  "\"desc§Breadcrumb 面包屑\" = \"Clicking a non-current crumb jumps there; current crumb is inert.\"\n" +
  "\"desc§Pagination 分页\" = \"Accent current page; click a number to switch.\"\n" +
  "\"desc§Steps 步骤条\" = \"Done/current/todo states; buttons advance or rewind.\"\n" +
  "\"desc§手动计数器与三种派生接法\" = \"Derived values must be wired manually, three ways with different costs.\"\n" +
  "\"desc§与信号版对照\" = \"The signal form declares computed(fn(){ counter.get()*2 }) at the definition site.\"\n" +
  "\"desc§bind_node 原位重建子树\" = \"A Store drives bind_node to destroy and rebuild this subtree each click; siblings stay put, old subscriptions retire.\"\n" +
  "\"desc§系统与桌面\" = \"Read-only distro, machine, memory, uptime, desktop env, env vars, wallpaper and printers.\"\n" +
  "\"desc§显示器\" = \"Current modes and all outputs (read-only native data per platform).\"\n" +
  "\"desc§应用与文件\" = \"Installed app stats, common binaries and recent VS Code workspaces.\"\n" +
  "\"desc§浏览器数据\" = \"Chromium history/downloads/bookmarks and Firefox history, read locally.\"\n" +
  "\"desc§剪贴板与桌面状态\" = \"Clipboard text, idle reading and autostart state (read-only).\"\n" +
  "\"desc§文件对话框\" = \"A native modal file dialog; open echoes the path, save writes a line.\"\n" +
  "\"desc§原生消息框\" = \"A native modal message box normalizing the result to semantic enums.\"\n" +
  "\"desc§系统通知\" = \"System notification center: plain and progress notifications; unsupported backends say so.\"\n" +
  "\"desc§剪贴板\" = \"Read/write the system clipboard text.\"\n" +
  "\"desc§定时器与延时任务\" = \"Host timer period table plus one-shot set_timeout; both self-reschedule.\"\n" +
  "\"desc§系统托盘\" = \"Tray left-click counts, right-click pops a menu, dispatched via a 200ms poll.\"\n" +
  "\"desc§开机自启动\" = \"Toggles the real autostart state (Linux ~/.config/autostart, Windows Run key).\"\n" +
  "\"desc§打开外部\" = \"Open URLs/files with defaults or chosen apps, and reveal paths in the file manager.\"\n" +
  "\"desc§系统信息与音量\" = \"System info plus volume read/set/mute with explicit unsupported handling.\"\n" +
  "\"desc§窗口 API\" = \"Runtime title, fullscreen, size toggle and borderless; unsupported actions omitted.\"\n" +
  "\"desc§全局快捷键\" = \"System-wide hotkeys (Windows only); other platforms report Unsupported.\"\n" +
  "\"desc§应用内拖放 + 系统级拖入 / 拖出\" = \"Internal drag from the color block to the panel; external drag-in and drag-out on all platforms.\"\n" +
  "\"desc§开子窗 / 列窗 / 关子窗\" = \"Process-wide window registry: open, count, active and close per window.\"\n" +
  "\"desc§窗口透明与背景穿透\" = \"set_opacity and set_transparent_bg; combine both for see-through content.\"\n" +
  "\"desc§窗口层级嵌入\" = \"set_layer switches z-order tiers (normal/desktop/desktop-widget/top/dock).\"\n" +
