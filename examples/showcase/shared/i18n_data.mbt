  "\"desc§用户与团队\" = \"Users, teams, add/remove members, gender and occupation.\"\n" +
  "\"desc§安全与锁定\" = \"Lock, key, visibility, certificate and scan.\"\n" +
  "\"desc§时间与日历\" = \"Clock, timer, calendar, loading and sync.\"\n" +
  "\"desc§状态与反馈\" = \"Check/cross, ring states, emoji, like, favorite and power.\"\n" +
  "\"desc§金融与商业\" = \"Currency, wallet, bank, shopping, trophy and membership.\"\n" +
  "\"desc§系统与工具\" = \"Login/logout, import/export, settings, filter and build.\"\n" +
  "\"desc§天气与饮食\" = \"Weather glyphs, drinks, food and tableware.\"\n" +
  "\"desc§媒体与出行\" = \"Images, media, ball sports, transport and location.\"\n" +
  "\"desc§品牌与平台\" = \"Platforms, social and cloud vendor marks.\"\n" +
  "\"desc§其他\" = \"MES business and misc icons (pinyin-named).\"\n" +
  "\"desc§Side Menu 侧边导航\" = \"This very sidebar: collapsible groups, light-blue selection with accent bar.\"\n" +
  "\"desc§右键菜单、下拉菜单与原生菜单栏\" = \"Context menu wraps any node; dropdown expands candidates; native menu bar shown structurally.\"\n" +
  "\"desc§Segmented 分段控制器\" = \"Top-bar navigation sharing the same Store as the sidebar, so clicking really switches pages.\"\n" +
  "\"desc§Tabs 页签\" = \"Top tabs with an accent indicator; children are prebuilt and toggled by visibility.\"\n" +
  "\"desc§Breadcrumb 面包屑\" = \"Clicking a non-current crumb jumps there; current crumb is inert.\"\n" +
  "\"desc§Pagination 分页\" = \"Accent current page; click a number to switch.\"\n" +
  "\"desc§Steps 步骤条\" = \"Done/current/todo states; buttons advance or rewind.\"\n" +
  "\"desc§手动计数器与三种派生接法\" = \"Derived values must be wired manually, three ways with different costs.\"\n" +
  "\"desc§与信号版对照\" = \"The signal form declares computed(fn(){ counter.get()*2 }) at the definition site.\"\n" +
  "\"desc§bind_node 原位重建子树\" = \"A Store drives bind_node to destroy and rebuild this subtree each click; siblings stay put, old subscriptions retire.\"\n" +
  "\"desc§系统与桌面\" = \"Read-only distro, machine, memory, uptime, desktop env, env vars, wallpaper and printers.\"\n" +
  "\"desc§显示器\" = \"Current modes and all outputs (read-only native data per platform).\"\n" +
  "\"desc§应用与文件\" = \"Installed app stats, common binaries and recent VS Code workspaces.\"\n" +
  "\"desc§浏览器数据\" = \"Chromium history/downloads/bookmarks and Firefox history, read locally.\"\n" +
  "\"desc§剪贴板与桌面状态\" = \"Clipboard text, idle reading and autostart state (read-only).\"\n" +
  "\"desc§文件对话框\" = \"A native modal file dialog; open echoes the path, save writes a line.\"\n" +
  "\"desc§原生消息框\" = \"A native modal message box normalizing the result to semantic enums.\"\n" +
  "\"desc§系统通知\" = \"System notification center: plain and progress notifications; unsupported backends say so.\"\n" +
  "\"desc§剪贴板\" = \"Read/write the system clipboard text.\"\n" +
  "\"desc§定时器与延时任务\" = \"Host timer period table plus one-shot set_timeout; both self-reschedule.\"\n" +
  "\"desc§系统托盘\" = \"Tray left-click counts, right-click pops a menu, dispatched via a 200ms poll.\"\n" +
  "\"desc§开机自启动\" = \"Toggles the real autostart state (Linux ~/.config/autostart, Windows Run key).\"\n" +
  "\"desc§打开外部\" = \"Open URLs/files with defaults or chosen apps, and reveal paths in the file manager.\"\n" +
  "\"desc§系统信息与音量\" = \"System info plus volume read/set/mute with explicit unsupported handling.\"\n" +
  "\"desc§窗口 API\" = \"Runtime title, fullscreen, size toggle, borderless, and maximize / restore. The system title bar already has a maximize button on all three platforms; set_maximized and is_maximized add the ability to place that key in a borderless self-drawn title bar. is_maximized asks the platform instead of caching, so it still reads correctly after you click the system button.\"\n" +
  "\"desc§全局快捷键\" = \"System-wide hotkeys (Windows only); other platforms report Unsupported.\"\n" +
  "\"desc§应用内拖放 + 系统级拖入 / 拖出\" = \"Internal drag from the color block to the panel; external drag-in and drag-out on all platforms.\"\n" +
  "\"desc§开子窗 / 列窗 / 关子窗\" = \"Process-wide window registry: open, count, active and close per window.\"\n" +
  "\"desc§窗口透明与背景穿透\" = \"Two different things. set_opacity is whole-window alpha (0-255): text and controls fade together, and it needs a compositor. set_transparent_bg is background see-through: pixels no control painted stay transparent so the desktop shows through, while controls that did paint a background stay opaque (on Windows it needs a borderless window; a framed one silently falls back). The main window cannot show the latter - this whole page is painted edge to edge, so there are no unpainted pixels; use the transparent test window button to open a separate borderless window with only a few cards in it.\"\n" +
  "\"desc§窗口层级嵌入\" = \"Panel tiers (below icons / above icons / dock) promise the same three things: out of the taskbar and window list, out of the window cycle, resident on every workspace - plus keep-above for the dock tier. Borders are deliberately not part of the promise: appearance follows the styleMask you pass and your own system window settings. How each platform delivers it: Linux sends explicit _NET_WM_STATE ABOVE/SKIP_TASKBAR/SKIP_PAGER/STICKY instead of retyping the window (TYPE_DOCK would also strip decorations and drop it out of the focus list), macOS sets CanJoinAllSpaces|Stationary|IgnoresCycle and the dock tier adds FullScreenAuxiliary at dock level, Win32 uses WS_EX_TOOLWINDOW for taskbar/Alt+Tab identity and SetWindowPos for stacking, while the below-icons tier re-parents this window into Explorer's wallpaper WorkerW - the only place on Win32 that sits under the desktop icons, paid for with WS_CHILD taking the decorations away and no keyboard focus (this tier is defined as events going to the desktop). Nobody gets a reserved work area (no AppBar on Windows, no API on macOS); the WM, Shell or AppKit has the final word.\"\n" +
  "\"窗口层级嵌入（探针窗）\" = \"Window layers (probe window)\"\n" +
  "\"desc§窗口层级嵌入（探针窗）\" = \"A layer says which desktop tier a window occupies, so the demo does not use the board itself as the subject: open a small probe window and switch all five tiers on it while the main window stays normal - switching to below-icons or dock never drags the board down with it. Panel tiers promise out of taskbar and window list, out of the window cycle, resident on every workspace (dock adds keep-above); borders are not part of the promise. Linux sends _NET_WM_STATE ABOVE/SKIP_TASKBAR/SKIP_PAGER/STICKY, macOS sets CanJoinAllSpaces|Stationary|IgnoresCycle, Win32 uses WS_EX_TOOLWINDOW plus SetWindowPos and re-parents the below-icons tier into Explorer's wallpaper WorkerW.\"\n" +
  "\"显隐驻留\" = \"Hide / show residency\"\n" +
  "\"desc§显隐驻留\" = \"hide() puts the window away and show() brings it back at the screen origin it had before hiding - not re-centred. This cannot be tested on the main window: hiding it takes the board away with no button left to bring it back. So a separate residency probe opens pinned at (160, 160); it carries its own hide button, the main window's recall button calls show(), and the position readout proves the coordinates are still (160, 160).\"\n" +
  "\"防多开与唤起已有实例\" = \"Prevent a second instance & recall the first\"\n" +
  "\"desc§防多开与唤起已有实例\" = \"One native channel per platform behind a single facade: Windows uses a Local-session namespace mutex plus a hidden window that receives WM_COPYDATA; Linux first contests a D-Bus well-known name and falls back to an AF_UNIX socket when there is no session bus; macOS uses the AF_UNIX socket. The board claims the id at startup. Read backend shows which channel won and how many wakes this process received; Wake self sends one to this very process and the next tick recalls the first page with a toast. Two-process check: run the same command again in another terminal - the second process prints SHOWCASE-INST and exits, the running window is recalled.\"\n" +
  "\"开层级探针窗\" = \"Open layer probe\"\n" +
  "\"关探针窗\" = \"Close probe\"\n" +
  "\"开驻留探针窗\" = \"Open residency probe\"\n" +
  "\"隐藏\" = \"Hide\"\n" +
  "\"唤回\" = \"Recall\"\n" +
  "\"读窗位置\" = \"Read position\"\n" +
  "\"隐藏我自己\" = \"Hide me\"\n" +
  "\"层级作用在我这扇窗上\" = \"The layer applies to this window\"\n" +
  "\"主窗保持普通档：切「图标下 / Dock」时只有我掉层，演示板不会跟着消失。\" = \"The main window stays normal: switching to below-icons or dock drops only me, the board stays put.\"\n" +
  "\"固定落在 (160, 160)\" = \"Pinned at (160, 160)\"\n" +
  "\"先点「开层级探针窗」，层级施加在它身上而不是演示板\" = \"Open the layer probe first - the layer applies to it, not to the board\"\n" +
  "\"层级探针窗已经开着（下面五档切的就是它）\" = \"The layer probe is already open (the five tiers below switch it)\"\n" +
  "\"已开层级探针窗：下面五档都切这一扇\" = \"Layer probe opened: the five tiers below switch it\"\n" +
  "\"探针窗已关\" = \"Probe closed\"\n" +
  "\"探针窗本来就没开\" = \"No probe was open\"\n" +
  "\"驻留探针窗已经开着\" = \"The residency probe is already open\"\n" +
  "\"已开驻留探针窗，落在 (160, 160)\" = \"Residency probe opened at (160, 160)\"\n" +
  "\"（还没有显隐事件）\" = \"(no show/hide events yet)\"\n" +
  "\"2 秒后自动隐藏\" = \"Auto-hide after 2s\"\n" +
  "\"验隐藏清组合串：勾上 → 点输入框打拼音（别提交）→ 到点本窗 hide → 主窗唤回，组合串应已清。\" = \"To verify preedit clearing on hide: check this, click the field and type pinyin (do not commit); the window hides after 2s - after wake-up the preedit should be gone.\"\n" +
  "\"在这里打拼音\" = \"Type pinyin here\"\n" +
  "\"已 hide：探针窗应当从屏幕上消失\" = \"Hidden: the probe should be gone from the screen\"\n" +
  "\"已 show：应当回到 hide 前的原点，不是居中重开\" = \"Shown: it should return to the pre-hide origin, not re-centre\"\n" +
  "\"先点「开驻留探针窗」\" = \"Open the residency probe first\"\n" +
  "\"dyn.probe_origin\" = \"probe at ({x}, {y}), is_hidden={h}\"\n" +
  // —— 页正文显示串（key = 中文原文；`@shared.tx` 出口取译）——
