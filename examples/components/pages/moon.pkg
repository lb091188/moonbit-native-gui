// 演示板各页内容。每页一个文件；页内私有状态留在页函数体内，
// 跨页共享状态从 `shared` 的 `App` 取。
import {
  "moonbitlang/core/encoding/utf8",
  "NoahLiu/yoga-mbt/src" @yoga,
  "NoahLiu/native-gui/base",
  "NoahLiu/native-gui/widget",
  "NoahLiu/native-gui/shell",
  "NoahLiu/native-gui/render",
  "NoahLiu/native-gui/text",
  "NoahLiu/native-gui/ui",
  "NoahLiu/native-gui/win",
  "NoahLiu/native-gui/sys",
  "NoahLiu/native-gui/icons",
  "NoahLiu/native-gui/chart" @charts,
  "NoahLiu/native-gui/theme",
  "NoahLiu/native-gui/style",
  "NoahLiu/native-gui/mdview",
  "NoahLiu/gui-gpu/gpu" @guigpu,
  "NoahLiu/native-gui/mngdev",
  "NoahLiu/native-gui-examples-components/shared",
}

supported_targets = "native"
