# prepare.py 产物(vendor 仅根级:modules/ffmpeg-mbt/vendor 是模块必需的 vendored 头文件与导入库,勿升级为 **/vendor/)
/vendor/
**/.prepare/

# moon 构建产物
**/_build/
**/target/
*.core
*.generated.mbti

# C/C++ 构建产物目录(prebuild、CMake 等)
**/build/

# mooncakes 依赖缓存(moon install 下载,勿入库)
**/.mooncakes/

# 文档站依赖缓存
**/node_modules/

# wrangler 本地状态/缓存(wrangler CLI 在仓库内执行时生成)
/.wrangler/

# WebView2 loader(prepare.py 复制到仓库根,运行期按工作目录搜索)
/WebView2Loader.dll

# vendor 大文件改走 GitHub Release 资产(2026-10-14 起,prebuild 缺失时自动
# 下载并校验 sha256,勿入库——入库会永久占用 git 历史体积)
/modules/gui-webview/webview/lib/WebView2LoaderStatic.lib
/modules/gui-webview/webview/include/WebView2.h
/modules/gui-media/media/miniaudio.h
# mac 的 ffmpeg dev 归档同口径(prebuild 下载解包落点,制作脚本在
# modules/ffmpeg-mbt/scripts/make_mac_ffmpeg_vendor.sh;vendor/ 根级其余内容
# 是 Windows 的入库 vendor,勿动)
/modules/ffmpeg-mbt/vendor/mac/
# 制作脚本的本地产物目录(正式产物经 CI workflow 上传 artifact→Release,勿入库)
/modules/ffmpeg-mbt/dist/

# Windows 运行期 ffmpeg dll 的本地缓存(scripts/win_ffmpeg_dll.py 下载落点,
# 约 150MB,勿入库;补齐时复制到示例 exe 同目录)
/.cache/

# Python 缓存(moon package 与 git 同样排除)
**/__pycache__/

# 发布包排除(文件已在版本库,gitignore 只影响未跟踪文件,git 照常跟踪)
/AGENTS.md
/TODO.md

# AI 助手工作区记忆(非构建产物,不入库)
/.workbuddy/
/.workbuddy-ai/

# render 白盒测试的落盘副产物（写在工作目录，三平台同一相对路径）
/gui/moonbit-native-render-wbtest.png

# 文件管理器副产物
**/.DS_Store
