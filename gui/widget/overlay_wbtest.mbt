// 浮层摆位规则回归（`overlay.mbt` 的 `popup_fit`）：放得下不动、下方不够翻到锚点
// 上方、右方不够与锚点右缘对齐、翻完仍越界钳回边界、边界未知一律原样。纯函数，
// 不需要宿主。

///|
test "popup_fit：放得下原样、放不下翻边、越界钳回" {
  let a : Rect = { x: 20.0, y: 260.0, w: 150.0, h: 30.0 }
  // 放得下：请求位原样
  assert_eq(
    popup_fit(20.0, 100.0, 100.0, 60.0, 300.0, 300.0, anchor=Some(a)),
    (20.0, 100.0),
  )
  // 下方不够：翻到锚点上方，间距沿用请求位带的 2（请求位 = 锚点下缘 + 2）
  assert_eq(
    popup_fit(20.0, 292.0, 100.0, 84.0, 300.0, 300.0, anchor=Some(a)),
    (20.0, 174.0),
  )
  // 右方不够：与锚点右缘对齐，纵向不受影响
  assert_eq(
    popup_fit(250.0, 40.0, 100.0, 40.0, 300.0, 300.0, anchor=Some(a)),
    (70.0, 40.0),
  )
  // 翻完仍越界（弹层比窗口还高）：钳到 0，不留在负位
  assert_eq(
    popup_fit(20.0, 292.0, 100.0, 400.0, 300.0, 300.0, anchor=Some(a)),
    (20.0, 0.0),
  )
  // 没锚点（轻提示、右键菜单）只钳不翻
  assert_eq(popup_fit(20.0, 292.0, 100.0, 84.0, 300.0, 300.0), (20.0, 216.0))
  // 边界未知（给 0）：一律原样
  assert_eq(
    popup_fit(20.0, 292.0, 100.0, 84.0, 0.0, 0.0, anchor=Some(a)),
    (20.0, 292.0),
  )
}
