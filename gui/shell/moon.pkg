// 系统能力壳层：菜单栏/右键菜单、全局热键门面、托盘（SNI/Win32）、通知、
// 外部打开、单实例——六条与控件树零耦合的通道，只吃 base 常量、i18n 广播与
// win/sys/dbus 后端。

supported_targets = "native"

import {
  "moonbitlang/core/encoding/utf8",
  "NoahLiu/native-gui/win",
  "NoahLiu/native-gui/sys" @sys,
  "NoahLiu/native-gui/dbus" @dbus,
  "NoahLiu/native-gui/i18n" @i18n,
}

// shell_stub.c 是单实例的 POSIX 套接字臂，只用标准头，直接走 native-stub；
// 链接参数按 AGENTS 规则 1 由 scripts/prebuild.py 托管（本包无新增）。
options(
  "native-stub": [ "shell_stub.c" ],
)
