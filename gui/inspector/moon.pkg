// 内建 inspector(v1 只读面板 + 服务核):控件树浏览吃 `a11y_last_frame` 帧尾
// 快照、选中看布局/语义读数、`paint_profile_summary` 帧耗时账本;服务核
// (service.mbt + stub.c)提供 MNG_INSPECT 注入式只读检查通道,树/样式读数与
// 面板走同一份取数口。独立包的理由与 ui 同口径——分包零警告门禁只对干净的
// 包成立;应用按需 import,不进核心链。
// stub.c 只用标准头,直接走 native-stub(Windows 管道臂住 gui/win/stub.c,
// 本文件在 _WIN32 下为空,每平台恰好一份定义)。
supported_targets = "native"

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "NoahLiu/yoga-mbt/src" @yoga,
  "NoahLiu/native-gui/base",
  "NoahLiu/native-gui/shell",
  "NoahLiu/native-gui/widget",
  "NoahLiu/native-gui/ui",
  "NoahLiu/native-gui/style",
  "NoahLiu/native-gui/render",
  "NoahLiu/native-gui/text",
  "NoahLiu/native-gui/win",
  "NoahLiu/native-gui/i18n",
}

options(
  "native-stub": [ "stub.c" ],
)
