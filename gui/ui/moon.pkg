// 新栈组件层（自绘，一律返回声明式 `@widget.Node`）。
//
// 本包自成一层的理由是门禁口径：分包 `--deny-warn` 零警告只对干净的包成立，
// 混进其它实现就无从谈起。
supported_targets = "native"

import {
  "NoahLiu/yoga-mbt/src" @yoga,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/math",
  "NoahLiu/native-gui/base",
  "NoahLiu/native-gui/shell",
  "NoahLiu/native-gui/widget" @widget,
  "NoahLiu/native-gui/input",
  "NoahLiu/native-gui/icons",
  "NoahLiu/native-gui/render",
  "NoahLiu/native-gui/sys",
  "NoahLiu/native-gui/text",
  "NoahLiu/native-gui/theme",
  "NoahLiu/native-gui/style",
  "NoahLiu/native-gui/i18n" @i18n,
}
