      <ui-row class="actions">
        <ui-view class="spacer" />
        <ui-button text="去授权" @click="go_perm" />
      </ui-row>
    </ui-panel>
    <ui-panel title="快捷指令" class="card">
      <ui-col class="hint">
        <ui-text class="label" text="一行一个按钮：" />
