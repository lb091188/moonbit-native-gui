<script>
// 组件动作与展示辅助都住包级（ui_state.mbt / qrview.mbt）：
// segmented 与 qr_view 是同包 fn 组件，go_perm 是同包动作。
</script>
<template>
  <ui-view class="root">
  <segmented :options='["首页", "设置"]' :selected="s_page" />
  <ui-scroll-view class="pane" v-show='s_page.get() == "首页"'>
    <ui-panel title="服务" class="card">
      <ui-row class="field">
        <ui-text class="label" text="状态" />
        <ui-text class="value" :text="s_state.get()" />
      </ui-row>
      <ui-row class="field">
        <ui-text class="label" text="地址" />
        <ui-text class="value" :text="s_addr.get()" />
      </ui-row>
      <ui-row class="field">
        <ui-text class="label" text="已连接手机" />
        <ui-text class="value" :text="s_conns.get()" />
      </ui-row>
    </ui-panel>
    <ui-panel title="访问地址" class="card">
      <ui-view class="qrbox">
        <qr_view :img="s_qr" />
      </ui-view>
      <ui-text class="addr" :text="s_url.get()" wrap="false" ellipsis="true" />
    </ui-panel>
    <ui-panel title="最近上屏" class="card">
      <ui-text class="value" :text="s_history.get()" />
    </ui-panel>
  </ui-scroll-view>
  <ui-scroll-view class="pane" v-show='s_page.get() == "设置"'>
    <ui-panel title="辅助功能" class="card">
      <ui-row class="field">
        <ui-text class="label" text="授权状态" />
        <ui-text class="value" :text="s_perm.get()" />
