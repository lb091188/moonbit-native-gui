// 扫码页：静态 HTML 内嵌进二进制。顶栏（标题居左/状态居右）+ 输入框吃满
// 剩余空间 + 一行操作条（快捷 chips + ⏎回车 + 发送 + ⛶全屏）；心跳探活 +
// 断线自动重连（亮屏即连）；token 拼进 WS 地址，快捷指令从 /cfg 拉取。

///|
fn page_html(token : String) -> String {
  let lines : Array[String] = [
    "<!DOCTYPE html>",
    "<html lang=\"zh\">",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content\">",
    "<title>airtype</title>",
    "<style>",
    "  :root { color-scheme: light dark; }",
    "  html, body { height: 100%; }",
    "  body {",
    "    margin: 0; display: flex; flex-direction: column;",
    "    font: 16px/1.5 system-ui, -apple-system, sans-serif;",
    "  }",
    "  #head {",
    "    display: flex; align-items: center; justify-content: space-between;",
    "    gap: 8px; padding: 10px 16px;",
    "    padding-top: calc(10px + env(safe-area-inset-top));",
    "    border-bottom: 1px solid #8888;",
    "  }",
    "  #head h1 { font-size: 16px; margin: 0; }",
    "  #status { font-size: 13px; opacity: .7; margin: 0; text-align: right; }",
    "  #status.err { color: #d33; opacity: 1; }",
    "  #text {",
    "    flex: 1; width: 100%; box-sizing: border-box; min-height: 0;",
    "    resize: none; border: 0; outline: none; padding: 12px 16px;",
    "    font: 17px/1.6 system-ui, -apple-system, sans-serif;",
    "    background: transparent; color: inherit;",
    "  }",
    "  #bar {",
    "    display: flex; gap: 6px; align-items: stretch;",
    "    padding: 8px 12px calc(8px + env(safe-area-inset-bottom));",
    "    background: #fff; background: canvas;",
    "    border-top: 1px solid #8888; overflow-x: auto;",
    "  }",
    "  #bar button {",
    "    flex: 0 0 auto; border: 1px solid #8888; border-radius: 8px;",
    "    padding: 10px 12px; font: inherit; font-size: 15px;",
    "    background: transparent; color: inherit;",
    "  }",
    "  #btnSend {",
    "    border-color: #3d7eff; background: #3d7eff; color: #fff;",
    "    padding: 10px 18px;",
    "  }",
    "  #bar button:disabled { opacity: .5; }",
    "</style>",
    "</head>",
    "<body>",
    "  <div id=\"head\">",
    "    <h1>airtype</h1>",
    "    <p id=\"status\">连接中…</p>",
    "  </div>",
    "  <textarea id=\"text\" placeholder=\"在这里输入，发送后打进电脑聚焦的输入框\" autofocus></textarea>",
    "  <div id=\"bar\">",
    "    <button id=\"btnEnter\" title=\"回车\">⏎</button>",
    "    <button id=\"btnSend\">发送</button>",
    "    <button id=\"btnFs\" title=\"全屏\">⛶</button>",
    "  </div>",
    "<script>",
    "  var statusEl = document.getElementById('status');",
    "  var textEl = document.getElementById('text');",
    "  var sendEl = document.getElementById('btnSend');",
    "  var enterEl = document.getElementById('btnEnter');",
    "  var chipsWrap = document.getElementById('bar');",
    "  var ws = null, retry = 0, pending = false, pendingKind = '', lastPong = 0;",
    "  function setStatus(msg, isErr) {",
    "    statusEl.textContent = msg;",
    "    statusEl.className = isErr ? 'err' : '';",
    "  }",
    "  function setBusy(on) {",
    "    pending = on;",
    "    sendEl.disabled = on;",
    "    enterEl.disabled = on;",
    "  }",
    "  function connect() {",
    "    if (ws && (ws.readyState === 0 || ws.readyState === 1)) { return; }",
    "    setStatus('连接中…');",
    "    var proto = location.protocol === 'https:' ? 'wss://' : 'ws://';",
    "    ws = new WebSocket(proto + location.host + '/ws?t=" + token + "');",
    "    ws.onopen = function () {",
    "      retry = 0; lastPong = Date.now(); setStatus('已连接电脑');",
    "      try { textEl.focus(); } catch (e) {}",
    "    };",
    "    ws.onclose = function () {",
    "      setBusy(false);",
    "      setStatus('连接断开，自动重连中…', true);",
    "      var delay = Math.min(300 * Math.pow(2, retry), 5000);",
    "      retry++;",
    "      setTimeout(connect, delay);",
    "    };",
    "    ws.onerror = function () { ws.close(); };",
    "    ws.onmessage = function (ev) {",
    "      lastPong = Date.now();",
    "      if (ev.data === 'pong') { return; }",
    "      if (ev.data === 'ok') {",
    "        setBusy(false);",
    "        setStatus(pendingKind === 'enter' ? '已回车' : pendingKind === 'te' ? '已上屏并回车' : '已上屏');",
    "        if (pendingKind !== 'enter') { textEl.value = ''; }",
    "      } else if (ev.data.indexOf('err:') === 0) {",
    "        setBusy(false);",
    "        setStatus('上屏失败：' + ev.data.slice(4) + '（电脑端需授权辅助功能）', true);",
    "      }",
    "    };",
    "  }",
    "  function sendOp(op, body) {",
    "    if (pending) { return; }",
    "    if (!ws || ws.readyState !== 1) { setStatus('未连接，重连中…', true); retry = 0; connect(); return; }",
    "    pendingKind = op;",
    "    setBusy(true);",
    "    ws.send(op + '\\n' + body);",
    "  }",
    "  function sendTyped() {",
    "    var v = textEl.value;",
    "    if (!v.length) { return; }",
    "    sendOp('type', v);",
    "  }",
    "  sendEl.addEventListener('click', sendTyped);",
    "  enterEl.addEventListener('click', function () { sendOp('enter', ''); });",
    "  textEl.addEventListener('keydown', function (e) {",
    "    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); sendTyped(); }",
    "  });",
    "  setInterval(function () {",
    "    if (ws && ws.readyState === 1) {",
    "      if (Date.now() - lastPong > 15000) { ws.close(); return; }",
    "      try { ws.send('ping'); } catch (e) {}",
    "    }",
    "  }, 10000);",
    "  function poke() {",
    "    if (!ws || ws.readyState === 2 || ws.readyState === 3) { retry = 0; connect(); }",
    "    else if (ws.readyState === 1) {",
    "      try { ws.send('ping'); lastPong = Date.now(); } catch (e) { ws.close(); }",
    "    }",
    "    fetchCfg();",
    "  }",
    "  document.addEventListener('visibilitychange', function () {",
    "    if (!document.hidden) { poke(); }",
    "  });",
    "  window.addEventListener('pageshow', poke);",
    "  if (window.visualViewport) {",
    "    var vv = window.visualViewport;",
    "    var fit = function () {",
    "      document.body.style.height = vv.height + 'px';",
    "      if (vv.offsetTop > 0) { window.scrollTo(0, vv.offsetTop); }",
    "    };",
    "    vv.addEventListener('resize', fit);",
    "    vv.addEventListener('scroll', fit);",
    "  }",
    "  document.getElementById('btnFs').addEventListener('click', function () {",
    "    if (document.fullscreenElement) { document.exitFullscreen(); return; }",
    "    var el = document.documentElement;",
    "    if (el.requestFullscreen) { el.requestFullscreen().catch(function () {}); }",
    "  });",
    "  function fetchCfg() {",
    "    fetch('/cfg?t=" + token + "').then(function (r) { return r.json(); }).then(function (list) {",
    "      var old = chipsWrap.querySelectorAll('.chip');",
    "      for (var i = 0; i < old.length; i++) { chipsWrap.removeChild(old[i]); }",
    "      var fsBtn = document.getElementById('btnFs');",
    "      list.forEach(function (sc) {",
    "        var b = document.createElement('button');",
    "        b.className = 'chip';",
    "        b.textContent = sc.l;",
    "        b.addEventListener('click', function () {",
    "          sendOp(sc.e ? 'te' : 'type', sc.t);",
    "        });",
    "        chipsWrap.insertBefore(b, enterEl);",
    "      });",
    "    }).catch(function () {});",
    "  }",
    "  connect();",
    "  fetchCfg();",
    "</script>",
    "</body>",
    "</html>",
  ]
  let mut out = ""
  for l in lines {
    out = out + l + "\n"
  }
  out
}
