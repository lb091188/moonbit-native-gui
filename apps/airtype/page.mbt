// 扫码页：静态 HTML 内嵌进二进制。输入框 + 发送 + 连接状态 + 断线自动重连；
// token 由服务端拼进页面的 WS 地址。

///|
fn page_html(token : String) -> String {
  let lines : Array[String] = [
    "<!DOCTYPE html>",
    "<html lang=\"zh\">",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">",
    "<title>airtype</title>",
    "<style>",
    "  :root { color-scheme: light dark; }",
    "  body {",
    "    margin: 0; min-height: 100dvh; display: flex; flex-direction: column;",
    "    justify-content: center; gap: 12px; padding: 24px 16px;",
    "    font: 16px/1.5 system-ui, -apple-system, sans-serif;",
    "  }",
    "  h1 { font-size: 18px; margin: 0; text-align: center; }",
    "  #status { font-size: 13px; text-align: center; opacity: .7; margin: 0; }",
    "  #status.err { color: #d33; opacity: 1; }",
    "  textarea {",
    "    width: 100%; box-sizing: border-box; min-height: 96px; resize: vertical;",
    "    border-radius: 8px; border: 1px solid #8888; padding: 10px;",
    "    font: inherit; background: transparent; color: inherit;",
    "  }",
    "  button {",
    "    border: 0; border-radius: 8px; padding: 12px; font: inherit; font-size: 16px;",
    "    background: #3d7eff; color: #fff;",
    "  }",
    "  button:disabled { opacity: .5; }",
    "</style>",
    "</head>",
    "<body>",
    "  <h1>airtype</h1>",
    "  <p id=\"status\">连接中…</p>",
    "  <textarea id=\"text\" placeholder=\"在这里输入，发送后打进电脑聚焦的输入框\" autofocus></textarea>",
    "  <button id=\"send\">发送</button>",
    "<script>",
    "  var statusEl = document.getElementById('status');",
    "  var textEl = document.getElementById('text');",
    "  var sendEl = document.getElementById('send');",
    "  var ws = null, retry = 0, pending = false;",
    "  function setStatus(msg, isErr) {",
    "    statusEl.textContent = msg;",
    "    statusEl.className = isErr ? 'err' : '';",
    "  }",
    "  function connect() {",
    "    var proto = location.protocol === 'https:' ? 'wss://' : 'ws://';",
    "    ws = new WebSocket(proto + location.host + '/ws?t=" + token + "');",
    "    ws.onopen = function () { retry = 0; setStatus('已连接电脑'); };",
    "    ws.onclose = function () {",
    "      setStatus('连接断开，自动重连中…', true);",
    "      var delay = Math.min(1000 + retry * 1000, 5000);",
    "      retry++;",
    "      setTimeout(connect, delay);",
    "    };",
    "    ws.onerror = function () { ws.close(); };",
    "    ws.onmessage = function (ev) {",
    "      pending = false;",
    "      sendEl.disabled = false;",
    "      if (ev.data === 'ok') {",
    "        setStatus('已上屏');",
    "        textEl.value = '';",
    "      } else if (ev.data.indexOf('err:') === 0) {",
    "        setStatus('上屏失败：' + ev.data.slice(4) + '（电脑端需授权辅助功能）', true);",
    "      }",
    "    };",
    "  }",
    "  function send() {",
    "    if (pending) { return; }",
    "    if (!ws || ws.readyState !== 1) { setStatus('未连接', true); return; }",
    "    var v = textEl.value;",
    "    if (!v.length) { return; }",
    "    pending = true;",
    "    sendEl.disabled = true;",
    "    ws.send(v);",
    "  }",
    "  sendEl.addEventListener('click', send);",
    "  textEl.addEventListener('keydown', function (e) {",
    "    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); send(); }",
    "  });",
    "  connect();",
    "</script>",
    "</body>",
    "</html>",
  ]
  let mut out = ""
  for l in lines {
    out = out + l + "\n"
  }
  out
}
