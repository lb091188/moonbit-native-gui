{
  "name": "mng-vscode",
  "displayName": "MNG (native-gui template)",
  "description": ".mng 模板语言：语法着色、snippets，语义（诊断/补全/hover/跳转）经 mng lsp 提供",
  "version": "0.2.15",
  "publisher": "lb091188",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lb091188/moonbit-native-gui"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/tokenize.test.js test/lsp_session.test.js",
    "test:color": "node --test test/tokenize.test.js",
    "test:lsp": "node --test test/lsp_session.test.js",
    "test:vscode": "node test/run_vscode.js"
  },
  "activationEvents": [
    "onLanguage:mng",
    "workspaceContains:**/*.mng"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mng.dev",
        "title": "MNG: dev — 模板开发循环"
      },
      {
        "command": "mng.newPage",
        "title": "MNG: 新建页面"
      }
    ],
    "configurationDefaults": {
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*.mng": "*.gen.mbt"
      },
      "files.associations": {
        "*.gen.mbt": "mng-gen"
      },
      "[mng]": {
        "editor.bracketPairColorization.enabled": false
      }
    },
    "languages": [
      {
        "id": "mng",
        "aliases": [
          "MNG",
          "mng"
        ],
        "extensions": [
          ".mng"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mng-gen",
        "aliases": [
          "MNG Gen"
        ]
      }
    ],
    "grammars": [
      {
        "language": "mng",
        "scopeName": "source.mng",
        "path": "./syntaxes/mng.tmLanguage.json"
      },
      {
        "language": "mng-gen",
        "scopeName": "source.moonbit.gen",
        "path": "./syntaxes/mng-gen.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mng",
        "path": "./snippets/mng.json"
      }
    ],
    "configuration": {
      "title": "MNG",
      "properties": {
        "mng.cliPath": {
          "type": "string",
          "default": "mng",
          "description": "mng 可执行文件路径（moon install tools/native-gui-tools 后可留默认，走 PATH）"
        },
        "mng.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "启用语义能力（诊断/补全/hover/跳转）。关闭后只保留着色与 snippets"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.75",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
