// .mng 编译 CLI（终端形态）：build / map-errors / ir / new / dev。I/O 走 moonbitlang/x；
// 进程与单实例客户端在 tools 内自给（proc / inst），不依赖 GUI 库。
import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
  "NoahLiu/native-gui-tools/mngkit",
  "NoahLiu/native-gui-tools/proc",
  "NoahLiu/native-gui-tools/inst",
}

pkgtype(kind: "executable")

supported_targets = "native"
