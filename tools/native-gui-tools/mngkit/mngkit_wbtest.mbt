// mngkit 金样测试：生成码确定性（逐字对照）、各指令落点、错误与坐标。

///|
fn t1_src() -> String {
  [
    "<script setup lang=\"moonbit\">",
    "let qty : @base.Store[Int] = @base.Store::new(3)",
    "</script>",
    "<template>",
    "  <ui-col>",
    "    <ui-stepper v-model=\"qty\" max=\"10\" />",
    "    当前数量：{{ qty }}",
    "  </ui-col>",
    "</template>",
  ].join("\n") + "\n"
}

///|
fn t1_expect() -> String {
  [
    "// GENERATED by mngc（native-gui 模板编译器）。来源：page.mng。DO NOT EDIT。",
    "///|",
    "pub fn page() -> @widget.Node {",
    "  let qty : @base.Store[Int] = @base.Store::new(3)",
    "  @ui.col([",
    "    @ui.stepper(qty, max=10),",
    "    @ui.bind_label(qty, fn(_v) { \"当前数量：\\{qty.get()}\" }),",
    "  ])",
    "}",
  ].join("\n") + "\n"
}

///|
test "golden：插值/值槽/静态属性逐字对照（生成码确定性的契约）" {
  let code = match compile(t1_src(), "page.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_eq(code, t1_expect())
}

///|
test "source map：生成行 → 模板行列（步进器行、插值行）" {
  let r = match compile(t1_src(), "page.mng") {
    Ok(o) => o
    Err(e) => abort("\{e}")
  }
  // 生成第 6 行（stepper）→ 模板第 6 行；第 7 行（bind_label）→ 模板第 7 行
  assert_true(contains_sub(r.map, "6\t6\t"))
  assert_true(contains_sub(r.map, "7\t7\t"))
}

///|
fn t2_src() -> String {
  [
    "<script setup lang=\"moonbit\">",
    "let wifi : @base.Store[Bool] = @base.Store::new(true)",
    "let nick : @base.Store[String] = @base.Store::new(\"\")",
    "let err_nick = @ui.validate(nick, @ui.required())",
    "let sh_section = @shared.section",
    "// @mng sh-section = @shared.section positional(title, subtitle, desc, children)",
    "</script>",
    "<template>",
    "  <ui-col>",
    "    <ui-checkbox :label='@shared.tx(\"自动\")' v-model=\"wifi\" />",
    "    <ui-text v-if=\"wifi\" :text='@shared.tx(\"开\")' />",
    "    <ui-text v-else text=\"关\" />",
    "    <ui-text v-show=\"wifi\" text=\"常驻\" />",
    "    <ui-button text=\"清空\" @click=\"on_clear\" />",
    "    <sh-section title=\"校验\" subtitle=\"Form\" desc=\"即时\">",
    "      <ui-form-item label=\"昵称\">",
    "        <ui-input v-model=\"nick\" :error=\"err_nick\" placeholder=\"至少 2 个字符\" />",
    "      </ui-form-item>",
    "    </sh-section>",
    "  </ui-col>",
    "</template>",
  ].join("\n") + "\n"
}

///|
test "指令落点：v-if 链 bind_node、v-show when_bool、@click、@mng 组件、:error 直传" {
  let code = match compile(t2_src(), "t2.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  // v-if 链：全链条件并集进一个 computed，body 重判
  assert_true(
    contains_sub(
      code,
      "@widget.bind_node(@base.Signal::computed(fn() { wifi.get() }), fn(_v) {",
    ),
  )
  assert_true(contains_sub(code, "if wifi.get() {"))
  assert_true(contains_sub(code, "} else {"))
  // v-show → when_bool
  assert_true(
    contains_sub(code, "@ui.when_bool(@base.Signal::computed(fn() { wifi.get() }), @ui.text(\"常驻\"))"),
  )
  // @click → on_click=函数名
  assert_true(contains_sub(code, "@ui.button(\"清空\", on_click=on_clear)"))
  // @mng 组件按 positional 展开、children 数组收尾
  assert_true(contains_sub(code, "@shared.section(\"校验\", \"Form\", \"即时\", ["))
  // :error 直传 Store（求值一次语义）
  assert_true(
    contains_sub(code, "@ui.form_item(\"昵称\", @ui.input(nick, error=err_nick, placeholder=\"至少 2 个字符\""),
  )
}

///|
test "错误与坐标：未登记组件 / 孤儿 v-else / 缺 @mng 声明 / 多根 / 未闭合插值" {
  let r1 = compile("<template>\n  <ui-fancy text=\"x\" />\n</template>", "a.mng")
  assert_true(
    match r1 {
      Err(e) => contains_sub(e, "未登记") && contains_sub(e, "行 2")
      _ => false
    },
  )
  let r2 = compile(
    "<template>\n  <ui-col>\n    <ui-text v-else text=\"x\" />\n  </ui-col>\n</template>",
    "b.mng",
  )
  assert_true(match r2 {
    Err(e) => contains_sub(e, "v-else")
    _ => false
  })
  let r3 = compile(
    "<script setup lang=\"moonbit\">\nlet card = @ui.panel\n</script>\n<template>\n  <card>\n    <ui-text text=\"x\" />\n  </card>\n</template>",
    "c.mng",
  )
  assert_true(match r3 {
    Err(e) => contains_sub(e, "positional")
    _ => false
  })
  let r4 = compile("<template>\n  <ui-col />\n  <ui-col />\n</template>", "d.mng")
  assert_true(match r4 {
    Err(e) => contains_sub(e, "单根")
    _ => false
  })
  let r5 = compile(
    "<template>\n  <ui-col>\n    文本 {{ qty }\n  </ui-col>\n</template>",
    "e.mng",
  )
  assert_true(match r5 {
    Err(e) => contains_sub(e, "未闭合")
    _ => false
  })
  let r6 = compile(
    "<script setup lang=\"moonbit\">\nfn h() { () }\n</script>\n<template>\n  <ui-button text=\"x\" @scroll=\"h\" />\n</template>",
    "f.mng",
  )
  assert_true(match r6 {
    Err(e) => contains_sub(e, "@事件不支持")
    _ => false
  })
}

///|
test "文本归一化：模板缩进不进生成串；多源插值走 computed" {
  let code = match compile(
      "<script setup lang=\"moonbit\">\nlet a : @base.Store[Int] = @base.Store::new(1)\nlet b : @base.Store[Int] = @base.Store::new(2)\n</script>\n<template>\n  <ui-col>\n    合计 {{ a }} + {{ b }}\n  </ui-col>\n</template>",
      "g.mng",
    ) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(
    contains_sub(code, "@ui.bind(@base.Signal::computed(fn() { \"合计 \\{a.get()} + \\{b.get()}\" }), fn(s) { s })"),
  )
}

///|
test "静态属性字面量判定：裸串按字符串、单引号透传 MoonBit 表达式、数字原样" {
  let code = match compile(
      "<template>\n  <ui-col row_gap='8.0' grow=\"1.0\" label=\"栏\" />\n</template>",
      "h.mng",
    ) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "], row_gap=8.0, grow=1.0, label=\"栏\")"))
}

///|
test "契约分类：结构重排 HOT；表达式换目标 / script 变动 COLD" {
  let base_src = "<script setup lang=\"moonbit\">\nlet a : @base.Store[Int] = @base.Store::new(1)\n</script>\n<template>\n  <ui-col>\n    <ui-stepper v-model=\"a\" />\n    值 {{ a }}\n  </ui-col>\n</template>"
  let base = match contract_of(base_src, "x.mng") {
    Ok(c) => c
    Err(e) => abort("\{e}")
  }
  // 结构重排 + 增删静态节点：表达式集不变 → HOT
  let hot = match contract_of(
      "<script setup lang=\"moonbit\">\nlet a : @base.Store[Int] = @base.Store::new(1)\n</script>\n<template>\n  <ui-col>\n    新说明文字\n    值 {{ a }}\n    <ui-stepper v-model=\"a\" />\n  </ui-col>\n</template>",
      "x.mng",
    ) {
    Ok(c) => c
    Err(e) => abort("\{e}")
  }
  assert_true(hot.hot_ok(base))
  // 插值表达式变了（a+1）：闭包集合变化 → COLD
  let cold1 = match contract_of(
      "<script setup lang=\"moonbit\">\nlet a : @base.Store[Int] = @base.Store::new(1)\n</script>\n<template>\n  <ui-col>\n    值 {{ a + 1 }}\n  </ui-col>\n</template>",
      "x.mng",
    ) {
    Ok(c) => c
    Err(e) => abort("\{e}")
  }
  assert_true(!cold1.hot_ok(base))
  // script 段变了（新增状态字段）→ COLD
  let cold2 = match contract_of(
      "<script setup lang=\"moonbit\">\nlet a : @base.Store[Int] = @base.Store::new(1)\nlet b : @base.Store[Int] = @base.Store::new(2)\n</script>\n<template>\n  <ui-col>\n    值 {{ a }}\n  </ui-col>\n</template>",
      "x.mng",
    ) {
    Ok(c) => c
    Err(e) => abort("\{e}")
  }
  assert_true(!cold2.hot_ok(base))
}

///|
fn tir_src() -> String {
  [
    "<script setup lang=\"moonbit\">",
    "let wifi : @base.Store[Bool] = @base.Store::new(true)",
    "let nick : @base.Store[String] = @base.Store::new(\"\")",
    "</script>",
    "<template>",
    "  <ui-col row_gap=\"8.0\">",
    "    <ui-checkbox :label='@shared.tx(\"自动\")' v-model=\"wifi\" />",
    "    <ui-text v-if=\"wifi\" :text='@shared.tx(\"开\")' />",
    "    <ui-text v-else text=\"关\" />",
    "    <ui-stepper v-model=\"nick\" max=\"9\" />",
    "    <ui-button text=\"清空\" @click=\"on_clear\" />",
    "  </ui-col>",
    "</template>",
  ].join("\n") + "\n"
}

///|
test "IR 输出：结构树 + 坐标键动态槽 + states/handlers 清单" {
  let ir = match ir_of(tir_src(), "tir.mng") {
    Ok(j) => j
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(ir, "\"k\":\"col\""))
  assert_true(contains_sub(ir, "\"k\":\"checkbox\""))
  assert_true(contains_sub(ir, "\"k\":\"stepper\""))
  assert_true(contains_sub(ir, "\"state\":\"wifi\""))
  assert_true(contains_sub(ir, "\"k\":\"if\",\"c\":\"c:"))
  assert_true(contains_sub(ir, "\"expr\":\"t:"))
  assert_true(contains_sub(ir, "\"states\":[\"wifi\",\"nick\"]"))
  assert_true(contains_sub(ir, "\"handlers\":[\"on_clear\"]"))
}

///|
test "IR 边界：自定义组件与 v-else-if 链转 COLD（ir_of 报错）" {
  let r1 = ir_of(t2_src(), "t2.mng")
  assert_true(
    match r1 {
      Err(e) => contains_sub(e, "v1 补丁边界")
      _ => false
    },
  )
  let r2 = ir_of(
    "<template>\n  <ui-col>\n    <ui-text v-if=\"a\" text=\"x\" />\n    <ui-text v-else-if=\"b\" text=\"y\" />\n  </ui-col>\n</template>",
    "e2.mng",
  )
  assert_true(
    match r2 {
      Err(e) => contains_sub(e, "v-else-if")
      _ => false
    },
  )
}


///|
fn card_sig() -> String {
  "pub fn card(title : String, qty : @base.Store[Int], on_reset : () -> Unit, wide? : Bool = false) -> @widget.Node {"
}

///|
test "props 头：升 pub、未用 props 消警告垫片、槽类型进响应判定" {
  let src = [
    "<script setup lang=\"moonbit\">",
    "fn card(title : String, qty : @base.Store[Int], on_reset : () -> Unit, wide? : Bool = false) -> @widget.Node",
    "let extra : @base.Store[Int] = @base.Store::new(1)",
    "</script>",
    "<template>",
    "  <ui-col>",
    "    <ui-text :text=\"title\" />",
    "    附加：{{ extra }}",
    "  </ui-col>",
    "</template>",
  ].join("\n")
  let code = match compile(src, "card.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  let expect = [
    "// GENERATED by mngc（native-gui 模板编译器）。来源：card.mng。DO NOT EDIT。",
    "///|",
    "pub fn card(title : String, qty : @base.Store[Int], on_reset : () -> Unit, wide? : Bool = false) -> @widget.Node {",
    "  let _ = qty",
    "  let _ = on_reset",
    "  let _ = wide",
    "  let extra : @base.Store[Int] = @base.Store::new(1)",
    "  @ui.col([",
    "    @ui.text(title),",
    "    @ui.bind_label(extra, fn(_v) { \"附加：\\{extra.get()}\" }),",
    "  ])",
    "}",
  ].join("\n") + "\n"
  assert_eq(code, expect)
}

///|
test "props 头缺返回类型报错；页内辅助函数不当头" {
  let r = compile(
    "<script setup lang=\"moonbit\">\nfn card(title : String)\n</script>\n<template>\n  <ui-col />\n</template>",
    "x.mng",
  )
  assert_true(
    match r {
      Err(e) => contains_sub(e, "props 头需要返回类型")
      _ => false
    },
  )
  let ok = compile(
    "<script setup lang=\"moonbit\">\nfn on_reset(q : @base.Store[Int]) { q.set(0) }\nlet qty : @base.Store[Int] = @base.Store::new(1)\n</script>\n<template>\n  <ui-col>\n    数量：{{ qty }}\n    <ui-button text=\"重置\" @click=\"on_reset\" />\n  </ui-col>\n</template>",
    "y.mng",
  )
  match ok {
    Ok(o) => {
      assert_true(contains_sub(o.code, "pub fn y() -> @widget.Node {"))
      assert_true(contains_sub(o.code, "on_click=on_reset"))
    }
    Err(e) => abort("\{e}")
  }
}

///|
test "跨包组件：路径从 let 右值推、顺序取签名、只作绑定的 let 不进生成体" {
  let src = [
    "<script setup lang=\"moonbit\">",
    "let card = @pages.card",
    "let qty : @base.Store[Int] = @base.Store::new(2)",
    "fn on_reset() { qty.set(0) }",
    "</script>",
    "<template>",
    "  <ui-col>",
    "    <card title=\"计数\" :qty=\"qty\" @reset=\"on_reset\" />",
    "  </ui-col>",
    "</template>",
  ].join("\n")
  let fake = fn(p : String) -> String? {
    if p == "@pages.card" {
      Some(card_sig())
    } else {
      None
    }
  }
  let code = match compile_with(src, "home.mng", fake) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "    @pages.card(\"计数\", qty, on_reset),"))
  assert_true(!contains_sub(code, "let card = @pages.card"))
}

///|
test "同包组件零声明：裸名解析签名；解析失败指路 @mng" {
  let src =
    "<template>\n  <ui-col>\n    <card title=\"计数\" />\n  </ui-col>\n</template>"
  let ok = compile_with(
    src,
    "home.mng",
    fn(p : String) -> String? {
      if p == "card" {
        Some("pub fn card(title : String) -> @widget.Node {")
      } else {
        None
      }
    },
  )
  match ok {
    Ok(o) => assert_true(contains_sub(o.code, "    card(\"计数\"),"))
    Err(e) => abort("\{e}")
  }
  let bad = compile_with(src, "home.mng", fn(_p : String) -> String? { None })
  assert_true(
    match bad {
      Err(e) => contains_sub(e, "// @mng") && contains_sub(e, "行 3")
      _ => false
    },
  )
}

///|
test "@mng 覆盖优先于自动解析（不规则落点逃生口）" {
  let src = [
    "<script setup lang=\"moonbit\">",
    "let page = @shared.page",
    "// @mng page = @shared.page positional(children)",
    "</script>",
    "<template>",
    "  <page>",
    "    <ui-text text=\"x\" />",
    "  </page>",
    "</template>",
  ].join("\n")
  let fake = fn(p : String) -> String? {
    if p == "@shared.page" { Some("pub fn page(secs : Array[Section]) -> @widget.Node {") } else { None }
  }
  let code = match compile_with(src, "home.mng", fake) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "  @shared.page(["))
  assert_true(contains_sub(code, "@ui.text(\"x\"),"))
}

///|
test "样式章：<style> 摊平成 define_class、class 引用出 class_of、令牌与关键字落点" {
  let src = [
    "<script setup lang=\"moonbit\">",
    "let qty : @base.Store[Int] = @base.Store::new(1)",
    "</script>",
    "<style>",
    ".card {",
    "  color: var(--text_primary);",
    "  background-color: #ffffff;",
    "  font-size: 14;",
    "  font-weight: semi-bold;",
    "  padding: 8;",
    "}",
    "</style>",
    "<template>",
    "  <ui-col class=\"card\" row_gap=\"8.0\">",
    "    <ui-text text=\"x\" />",
    "  </ui-col>",
    "</template>",
  ].join("\n")
  let code = match compile(src, "card.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(
    contains_sub(
      code,
      "@style.define_class(\"card\", @style.style(color=\"text_primary\", background_color=\"#ffffff\", font_size=14.0, font_weight=@text.FontWeight::SemiBold, padding=8.0))",
    ),
  )
  assert_true(contains_sub(code, "class=@style.class_of([\"card\"])"))
}

///|
test "样式章：深浅两份值——dark 档注册第二枚类、按系统偏好选" {
  let src = [
    "<style>",
    ".card {",
    "  background-color: #ffffff;",
    "}",
    ".card:dark {",
    "  background-color: #101014;",
    "}",
    "</style>",
    "<template>",
    "  <ui-col class=\"card\" />",
    "</template>",
  ].join("\n")
  let code = match compile(src, "card.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "@style.define_class(\"card:dark\", @style.style(background_color=\"#101014\"))"))
  assert_true(
    contains_sub(
      code,
      "class=@style.class_of(if @win.sys_color_scheme() == \"dark\" { [\"card\", \"card:dark\"] } else { [\"card\"] })",
    ),
  )
}

///|
test "样式章：坏属性/坏令牌/非类选择器/主题字面量都编译报错" {
  let bad_prop = compile(
    "<style>\n.card { box-shadow: none; }\n</style>\n<template>\n  <ui-col class=\"card\" />\n</template>",
    "a.mng",
  )
  assert_true(
    match bad_prop {
      Err(e) => contains_sub(e, "不是 Style 属性")
      _ => false
    },
  )
  let bad_tok = compile(
    "<style>\n.card { color: var(--nope); }\n</style>\n<template>\n  <ui-col class=\"card\" />\n</template>",
    "b.mng",
  )
  assert_true(
    match bad_tok {
      Err(e) => contains_sub(e, "不是主题色令牌")
      _ => false
    },
  )
  let bad_sel = compile(
    "<style>\ndiv { color: var(--border); }\n</style>\n<template>\n  <ui-col />\n</template>",
    "c.mng",
  )
  assert_true(
    match bad_sel {
      Err(e) => contains_sub(e, "只支持类选择器")
      _ => false
    },
  )
  let literal = compile(
    "<template>\n  <ui-button text=\"x\" color=\"primary\" />\n</template>",
    "d.mng",
  )
  assert_true(
    match literal {
      Err(e) => contains_sub(e, "样式字面量") && contains_sub(e, "class=")
      _ => false
    },
  )
}

///|
test "样式章：class 不在 IR v1 补丁边界（转 COLD）" {
  let r = ir_of(
    "<template>\n  <ui-col class=\"card\">\n    <ui-text text=\"x\" />\n  </ui-col>\n</template>",
    "e.mng",
  )
  assert_true(
    match r {
      Err(e) => contains_sub(e, "class 不在 v1 补丁边界")
      _ => false
    },
  )
}




///|
fn rich_src() -> String {
  [
    "<script setup lang=\"moonbit\">",
    "let qty : @base.Store[Int] = @base.Store::new(3)",
    "let wifi : @base.Store[Bool] = @base.Store::new(true)",
    "fn on_reset() { qty.set(3) }",
    "</script>",
    "<template>",
    "  <ui-col>",
    "    <ui-checkbox :label='@shared.tx(\"开\")' v-model=\"wifi\" />",
    "    <ui-text v-if=\"wifi\" text=\"开\" />",
    "    <ui-text v-else text=\"关\" />",
    "    数量：{{ qty }}",
    "    <ui-button text=\"重置\" @click=\"on_reset\" />",
    "  </ui-col>",
    "</template>",
  ].join("\n")
}


///|
test "dev 形态：登记语句逐字 + mng_dev_page 调用（状态保活骨架）" {
  let code = match compile_dev(t1_src(), "page.mng", fn(_p : String) -> String? { None }) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  let expect = [
    "// GENERATED by mngc（native-gui 模板编译器）。来源：page.mng。DO NOT EDIT。",
    "///|",
    "pub fn page() -> @widget.Node {",
    "  let qty : @base.Store[Int] = @base.Store::new(3)",
    "  let reg = @shared.mng_reg_new()",
    "  reg.expr(\"t:7:5\", fn() { \"当前数量：\\{qty.get()}\" })",
    "  reg.int(\"qty\", qty)",
    "  @shared.mng_dev_page(\"page\", reg, fn() {",
    "    @ui.col([",
    "      @ui.stepper(qty, max=10),",
    "      @ui.bind_label(qty, fn(_v) { \"当前数量：\\{qty.get()}\" }),",
    "    ])",
    "  })",
    "}",
  ].join("\n") + "\n"
  assert_eq(code, expect)
}

///|
test "dev 形态：expr/cond/handler/state 四类登记齐（键与 IR 同口径）" {
  let code = match compile_dev(rich_src(), "card.mng", fn(_p : String) -> String? { None }) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "reg.expr(\"t:8:18\", fn() { @shared.tx(\"开\") })"))
  assert_true(contains_sub(code, "reg.expr(\"t:11:5\", fn() { \"数量：\\{qty.get()}\" })"))
  assert_true(contains_sub(code, "reg.cond(\"c:9:5\", fn() { wifi.get() })"))
  assert_true(contains_sub(code, "reg.handler(\"on_reset\", on_reset)"))
  assert_true(contains_sub(code, "reg.bool(\"wifi\", wifi)"))
  assert_true(contains_sub(code, "@shared.mng_dev_page(\"card\", reg, fn() {"))
}

///|
test "样式章：布局枚举关键字 → @yoga 枚举；坏关键字报错" {
  let src = [
    "<style>",
    ".bar {",
    "  justify-content: space-between;",
    "  align-items: center;",
    "  align-self: flex-end;",
    "  flex-direction: row-reverse;",
    "  flex-wrap: nowrap;",
    "  display: flex;",
    "  position: absolute;",
    "}",
    "</style>",
    "<template>",
    "  <ui-col class=\"bar\" />",
    "</template>",
  ].join("\n")
  let code = match compile(src, "layout.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "justify_content=@yoga.JustifyContent::SpaceBetween"))
  assert_true(contains_sub(code, "align_items=@yoga.AlignItems::Center"))
  assert_true(contains_sub(code, "align_self=@yoga.AlignItems::FlexEnd"))
  assert_true(contains_sub(code, "flex_direction=@yoga.FlexDirection::RowReverse"))
  assert_true(contains_sub(code, "flex_wrap=@yoga.FlexWrap::NoWrap"))
  assert_true(contains_sub(code, "display=@yoga.Display::Flex"))
  assert_true(contains_sub(code, "position=@yoga.PositionType::Absolute"))
  // 坏关键字：报错且指路
  let bad = compile(
    "<style>\n.bar { justify-content: middle; }\n</style>\n<template>\n  <ui-col class=\"bar\" />\n</template>",
    "layout2.mng",
  )
  assert_true(
    match bad {
      Err(e) => contains_sub(e, "不认关键字")
      _ => false
    },
  )
}

///|
test "样式章：flex 简写展开 grow/shrink/basis；坏值报错" {
  let src = [
    "<style>",
    ".a { flex: 1 0 100%; }",
    ".b { flex: 2; }",
    ".c { flex_basis: 40%; flex-shrink: 0; }",
    "</style>",
    "<template>",
    "  <ui-col class=\"a\" />",
    "</template>",
  ].join("\n")
  let code = match compile(src, "flex.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "flex=1.0, flex_shrink=0.0, flex_basis_percent=100.0"))
  assert_true(contains_sub(code, "flex=2.0, flex_shrink=1.0, flex_basis=0.0"))
  assert_true(contains_sub(code, "flex_basis_percent=40.0, flex_shrink=0.0"))
  let bad_auto = compile(
    "<style>\n.a { flex: 1 0 auto; }\n</style>\n<template>\n  <ui-col class=\"a\" />\n</template>",
    "f1.mng",
  )
  assert_true(
    match bad_auto {
      Err(e) => contains_sub(e, "basis 要像素或百分比")
      _ => false
    },
  )
  let bad_len = compile(
    "<style>\n.a { flex: 1 2 3 4; }\n</style>\n<template>\n  <ui-col class=\"a\" />\n</template>",
    "f2.mng",
  )
  assert_true(
    match bad_len {
      Err(e) => contains_sub(e, "最多三段")
      _ => false
    },
  )
}

///|
test "引号：外层双引号里的单引号串自动换成双引号（单字符 Char 不动）" {
  let src = [
    "<script setup lang=\"moonbit\">",
    "let flag : @base.Store[Bool] = @base.Store::new(true)",
    "</script>",
    "<template>",
    "  <ui-col>",
    "    <ui-text :text=\"@shared.tx('已开启')\" />",
    "    备注 {{ 'abc' }}",
    "    <ui-text v-if=\"flag\" text=\"开\" />",
    "    <ui-text v-else text=\"关\" />",
    "  </ui-col>",
    "</template>",
  ].join("\n")
  let code = match compile(src, "q.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "@shared.tx(\"已开启\")"))
  assert_true(contains_sub(code, "\\{\"abc\"}"))
}

///|
test "引号：真正的 Char 字面量保持不动；含转义的单引号串报错指路" {
  let src = [
    "<script setup lang=\"moonbit\">",
    "let c : @base.Store[String] = @base.Store::new(\"a\")",
    "</script>",
    "<template>",
    "  <ui-col>",
    "    <ui-text v-if=\"c.get() == 'a'\" text=\"是\" />",
    "    <ui-text v-else text=\"否\" />",
    "  </ui-col>",
    "</template>",
  ].join("\n")
  let code = match compile(src, "q2.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "== 'a'"))
  let bad = compile(
    "<template>\n  <ui-col>\n    <ui-text :text=\"@shared.tx('it\\'s')\" />\n  </ui-col>\n</template>",
    "q3.mng",
  )
  assert_true(
    match bad {
      Err(e) => contains_sub(e, "字符字面量")
      _ => false
    },
  )
}
