///|
test "样式章：<style> 摊平成 define_class、class 引用出 class_of、令牌与关键字落点" {
  let src = [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(1)", "</script>",
    "<style>", ".card {", "  color: var(--text_primary);", "  background-color: #ffffff;",
    "  font-size: 14px;", "  font-weight: 600;", "  padding: 8px;", "}", "</style>",
    "<template>", "  <ui-col class=\"card\" row_gap=\"8.0\">", "    <ui-text text=\"x\" />",
    "  </ui-col>", "</template>",
  ].join("\n")
  let code = match compile(src, "card.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(
    contains_sub(
      code, "@style.define_class(\"card\", @style.style(color=\"text_primary\", background_color=\"#ffffff\", font_size=14.0, font_weight=@text.FontWeight::SemiBold, padding=8.0))",
    ),
  )
  assert_true(contains_sub(code, "class=@style.class_of([\"card\"])"))
}

///|
test "样式章：深浅两份值——dark 档注册第二枚类、按系统偏好选" {
  let src = [
    "<style>", ".card {", "  background-color: #ffffff;", "}", ".card:dark {", "  background-color: #101014;",
    "}", "</style>", "<template>", "  <ui-col class=\"card\" />", "</template>",
  ].join("\n")
  let code = match compile(src, "card.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(
    contains_sub(
      code, "@style.define_class(\"card:dark\", @style.style(background_color=\"#101014\"))",
    ),
  )
  assert_true(
    contains_sub(
      code, "class=@style.class_of(if @win.sys_color_scheme() == \"dark\" { [\"card\", \"card:dark\"] } else { [\"card\"] })",
    ),
  )
}

///|
test "样式章：坏属性/坏令牌/非类选择器/主题字面量都编译报错" {
  let bad_prop = compile(
    "<style>\n.card { box-shadow: none; }\n</style>\n<template>\n  <ui-col class=\"card\" />\n</template>",
    "a.mng",
  )
  assert_true(
    match bad_prop {
      Err(e) => contains_sub(e, "不是 Style 属性")
      _ => false
    },
  )
  let bad_tok = compile(
    "<style>\n.card { color: var(--nope); }\n</style>\n<template>\n  <ui-col class=\"card\" />\n</template>",
    "b.mng",
  )
  assert_true(
    match bad_tok {
      Err(e) => contains_sub(e, "不是主题色令牌")
      _ => false
    },
  )
  let bad_sel = compile(
    "<style>\ndiv { color: var(--border); }\n</style>\n<template>\n  <ui-col />\n</template>",
    "c.mng",
  )
  assert_true(
    match bad_sel {
      Err(e) => contains_sub(e, "只支持类选择器")
      _ => false
    },
  )
  let literal = compile(
    "<template>\n  <ui-button text=\"x\" color=\"primary\" />\n</template>", "d.mng",
  )
  assert_true(
    match literal {
      Err(e) => contains_sub(e, "样式字面量") && contains_sub(e, "class=")
      _ => false
    },
  )
}

