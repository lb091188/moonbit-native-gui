    "<template>", "  <ui-text>计数：{{ qty }}</ui-text>", "</template>",
  ].join("\n")
  match hot_ir(changed, base, "p.mng") {
    Ok(ir) => assert_true(contains_sub(ir, "\"tostr\""))
    Err(e) => abort("插值热更应通过：\{e}")
  }
}

///|
fn tir_src() -> String {
  [
    "<script>", "let wifi : @base.Store[Bool] = @base.Store::new(true)", "let nick : @base.Store[String] = @base.Store::new(\"\")",
    "</script>", "<template>", "  <ui-col row_gap=\"8.0\">", "    <ui-checkbox :label='@shared.tx(\"自动\")' v-model=\"wifi\" />",
    "    <ui-text v-if=\"wifi\" :text='@shared.tx(\"开\")' />", "    <ui-text v-else text=\"关\" />",
    "    <ui-stepper v-model=\"nick\" max=\"9\" />", "    <ui-button text=\"清空\" @click=\"on_clear\" />",
    "  </ui-col>", "</template>",
  ].join("\n") +
  "\n"
}

///|
test "IR 输出：结构树 + 内容键动态槽 + states/handlers 清单" {
  let ir = match ir_of(tir_src(), "tir.mng") {
    Ok(j) => j
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(ir, "\"k\":\"col\""))
  assert_true(contains_sub(ir, "\"k\":\"checkbox\""))
  assert_true(contains_sub(ir, "\"k\":\"stepper\""))
  assert_true(contains_sub(ir, "\"state\":\"wifi\""))
  assert_true(contains_sub(ir, "\"k\":\"if\",\"c\":\"c:"))
  assert_true(contains_sub(ir, "\"expr\":\"t:"))
  assert_true(contains_sub(ir, "\"states\":[\"wifi\",\"nick\"]"))
  assert_true(contains_sub(ir, "\"handlers\":[\"on_clear\"]"))
}

///|
test "HOT 键稳定：动态槽上方插静态行，IR 与登记表键都不漂" {
  let a = [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(0)", "</script>",
    "<template>", "  <ui-col row_gap=\"8.0\">", "    <ui-text :text='@shared.tx(\"A\")' />",
    "    <ui-stepper v-model=\"qty\" max=\"10\" />", "  </ui-col>", "</template>",
  ].join("\n")
  let b = [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(0)", "</script>",
    "<template>", "  <ui-col row_gap=\"8.0\">", "    <ui-text text=\"插一行\" />",
    "    <ui-text :text='@shared.tx(\"A\")' />", "    <ui-stepper v-model=\"qty\" max=\"10\" />",
    "  </ui-col>", "</template>",
  ].join("\n")
  let ia = match ir_of(a, "a.mng") {
    Ok(j) => j
    Err(e) => abort("\{e}")
  }
  let ib = match ir_of(b, "b.mng") {
    Ok(j) => j
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(ia, "\"key\":\"t:3fc746ec39ec6f8e\""))
  assert_true(contains_sub(ib, "\"key\":\"t:3fc746ec39ec6f8e\""))
  // 非位置参数也进 IR，补丁重建不丢 max
  assert_true(contains_sub(ib, "\"max\":{\"lit\":10}"))
  let ga = match compile_dev(a, "a.mng", fn(_p : String) -> String? { None }) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  let gb = match compile_dev(b, "b.mng", fn(_p : String) -> String? { None }) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(ga, "reg.expr(\"t:3fc746ec39ec6f8e\""))
  assert_true(contains_sub(gb, "reg.expr(\"t:3fc746ec39ec6f8e\""))
}

///|

///|
/// 取 IR 里的字符串字段值（一行 JSON：扫字符找 `"key":"` 后到下一个引号）。
fn ir_str_field(j : String, key : String) -> String {
  let cs = j.to_array()
  let pc = ("\"" + key + "\":\"").to_array()
  let mut i = 0
  while i + pc.length() <= cs.length() {
    let mut hit = true
    for k in 0..<pc.length() {
      if cs[i + k] != pc[k] {
        hit = false
      }
    }
    if hit {
      let out = StringBuilder()
      let mut q = i + pc.length()
      while q < cs.length() && cs[q] != '"' {
        out.write_char(cs[q])
        q += 1
      }
      return out.to_string()
    }
    i += 1
  }
  ""
}

///|
test "IR 握手字段：带 rev 与键集摘要，同 script 稳定、符号集变即变" {
  let ir = match ir_of(tir_src(), "tir.mng") {
    Ok(j) => j
    Err(e) => abort("\{e}")
  }
  assert_eq(ir_str_field(ir, "rev"), IR_REV)
  let base = ir_str_field(ir, "keys_digest")
  assert_eq(base.length(), 16)
  // 同一份源码两遍生成：摘要一致（工具与 applier 比的就是这一串）
  let ir2 = match ir_of(tir_src(), "tir.mng") {
    Ok(j) => j
    Err(e) => abort("\{e}")
  }
  assert_eq(ir_str_field(ir2, "keys_digest"), base)
  // 符号集少一个 handler（requires 键集变）：摘要跟着变
  let more = [
    "<script>", "let wifi : @base.Store[Bool] = @base.Store::new(true)", "let nick : @base.Store[String] = @base.Store::new(\"\")",
    "</script>", "<template>", "  <ui-col row_gap=\"8.0\">", "    <ui-checkbox :label='@shared.tx(\"\u81ea\u52a8\")' v-model=\"wifi\" />",
    "    <ui-stepper v-model=\"extra\" max=\"9\" />", "  </ui-col>", "</template>",
  ].join("\n")
  let j2 = match ir_of(more, "more.mng") {
    Ok(j) => j
    Err(e) => abort("\{e}")
  }
  assert_true(ir_str_field(j2, "keys_digest") != base)
  // 摘要与键序无关，与键集有关
  assert_eq(ir_keys_digest(["b", "a", "c"]), ir_keys_digest(["c", "b", "a"]))
  assert_true(
    ir_keys_digest(["b", "a", "c"]) != ir_keys_digest(["b", "a", "c", "d"]),
  )
}

///|
test "IR 边界：自定义组件与 v-else-if 链转 COLD（ir_of 报错）" {
  // 参数表外（:error）与自定义组件都要转 COLD；先钉自定义标签本身
  let r1 = ir_of(
    "<template>\n  <ui-col>\n    <my-card />\n  </ui-col>\n</template>", "t2b.mng",
  )
  assert_true(
    match r1 {
      Err(e) =>
        contains_sub(e, "自定义组件") && contains_sub(e, "v1 补丁边界")
      _ => false
    },
  )
  // 富模板里先撞上 <ui-input :error>（v1 参数表外），同样给了 COLD 指路
  let rfull = ir_of(t2_src(), "t2.mng")
  assert_true(
    match rfull {
      Err(e) => contains_sub(e, "不在 v1 补丁表")
      _ => false
    },
  )
  let r2 = ir_of(
    "<template>\n  <ui-col>\n    <ui-text v-if=\"a\" text=\"x\" />\n    <ui-text v-else-if=\"b\" text=\"y\" />\n  </ui-col>\n</template>",
    "e2.mng",
  )
  assert_true(
    match r2 {
      Err(e) => contains_sub(e, "v-else-if")
      _ => false
    },
  )
}

///|
fn card_sig() -> String {
  "pub fn card(title : String, qty : @base.Store[Int], on_reset : () -> Unit, wide? : Bool = false) -> @widget.Node {"
}

///|
test "props 头：升 pub、未用 props 消警告垫片、槽类型进响应判定" {
  let src = [
    "<script>", "fn card(title : String, qty : @base.Store[Int], on_reset : () -> Unit, wide? : Bool = false) -> @widget.Node",
    "let extra : @base.Store[Int] = @base.Store::new(1)", "</script>", "<template>",
    "  <ui-col>", "    <ui-text :text=\"title\" />", "    附加：{{ extra }}",
    "  </ui-col>", "</template>",
  ].join("\n")
  let code = match compile(src, "card.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  let expect = [
      "// GENERATED by mngc（native-gui 模板编译器）。来源：card.mng。DO NOT EDIT。",
      "///|", "pub fn card(title : String, qty : @base.Store[Int], on_reset : () -> Unit, wide? : Bool = false) -> @widget.Node {",
      "  let _ = qty", "  let _ = on_reset", "  let _ = wide", "  let extra : @base.Store[Int] = @base.Store::new(1)",
      "  @ui.col([", "    @ui.text(title),", "    @ui.bind_label(extra, fn(_v) { \"附加：\\{extra.get()}\" }),",
      "  ])", "}",
    ].join("\n") +
    "\n"
  assert_eq(code, expect)
}

///|
test "props 头缺返回类型报错；页内辅助函数不当头" {
  let r = compile(
    "<script>\nfn card(title : String)\n</script>\n<template>\n  <ui-col />\n</template>",
    "x.mng",
  )
  assert_true(
    match r {
      Err(e) => contains_sub(e, "props 头需要返回类型")
      _ => false
    },
  )
  let ok = compile(
    "<script>\nfn on_reset(q : @base.Store[Int]) { q.set(0) }\nlet qty : @base.Store[Int] = @base.Store::new(1)\n</script>\n<template>\n  <ui-col>\n    数量：{{ qty }}\n    <ui-button text=\"重置\" @click=\"on_reset\" />\n  </ui-col>\n</template>",
    "y.mng",
  )
  match ok {
    Ok(o) => {
      assert_true(contains_sub(o.code, "pub fn y() -> @widget.Node {"))
      assert_true(contains_sub(o.code, "on_click=on_reset"))
    }
    Err(e) => abort("\{e}")
  }
}

///|
test "跨包组件：路径从 let 右值推、顺序取签名、只作绑定的 let 不进生成体" {
  let src = [
    "<script>", "let card = @pages.card", "let qty : @base.Store[Int] = @base.Store::new(2)",
    "fn on_reset() { qty.set(0) }", "</script>", "<template>", "  <ui-col>", "    <card title=\"计数\" :qty=\"qty\" @reset=\"on_reset\" />",
    "  </ui-col>", "</template>",
  ].join("\n")
  let fake = fn(p : String) -> String? {
    if p == "@pages.card" {
      Some(card_sig())
    } else {
      None
    }
  }
  let code = match compile_with(src, "home.mng", fake) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "    @pages.card(\"计数\", qty, on_reset),"))
  assert_true(!contains_sub(code, "let card = @pages.card"))
}

///|
test "同包组件零声明：裸名解析签名；解析失败指路 @mng" {
  let src = "<template>\n  <ui-col>\n    <card title=\"计数\" />\n  </ui-col>\n</template>"
  let ok = compile_with(src, "home.mng", fn(p : String) -> String? {
    if p == "card" {
      Some("pub fn card(title : String) -> @widget.Node {")
    } else {
      None
    }
  })
  match ok {
    Ok(o) => assert_true(contains_sub(o.code, "    card(\"计数\"),"))
    Err(e) => abort("\{e}")
  }
  let bad = compile_with(src, "home.mng", fn(_p : String) -> String? { None })
  assert_true(
    match bad {
      Err(e) => contains_sub(e, "// @mng") && contains_sub(e, "行 3")
      _ => false
    },
  )
}

