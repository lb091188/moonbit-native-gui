test "样式章：布局枚举关键字 → @yoga 枚举；坏关键字报错" {
  let src = [
    "<style>", ".bar {", "  justify-content: space-between;", "  align-items: center;",
    "  align-self: flex-end;", "  flex-direction: row-reverse;", "  flex-wrap: nowrap;",
    "  display: flex;", "  position: absolute;", "}", "</style>", "<template>", "  <ui-col class=\"bar\" />",
    "</template>",
  ].join("\n")
  let code = match compile(src, "layout.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(
    contains_sub(code, "justify_content=@yoga.JustifyContent::SpaceBetween"),
  )
  assert_true(contains_sub(code, "align_items=@yoga.AlignItems::Center"))
  assert_true(contains_sub(code, "align_self=@yoga.AlignItems::FlexEnd"))
  assert_true(
    contains_sub(code, "flex_direction=@yoga.FlexDirection::RowReverse"),
  )
  assert_true(contains_sub(code, "flex_wrap=@yoga.FlexWrap::NoWrap"))
  assert_true(contains_sub(code, "display=@yoga.Display::Flex"))
  assert_true(contains_sub(code, "position=@yoga.PositionType::Absolute"))
