fn rich_src() -> String {
  [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(3)", "let wifi : @base.Store[Bool] = @base.Store::new(true)",
    "fn on_reset() { qty.set(3) }", "</script>", "<template>", "  <ui-col>", "    <ui-checkbox :label='@shared.tx(\"开\")' v-model=\"wifi\" />",
    "    <ui-text v-if=\"wifi\" text=\"开\" />", "    <ui-text v-else text=\"关\" />",
    "    数量：{{ qty }}", "    <ui-button text=\"重置\" @click=\"on_reset\" />",
    "  </ui-col>", "</template>",
  ].join("\n")
}

///|
test "dev 形态：登记语句逐字 + mng_dev_page 调用（状态保活骨架）" {
  let code = match
    compile_dev(t1_src(), "page.mng", fn(_p : String) -> String? { None }) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  let expect = [
      "// GENERATED by mngc（native-gui 模板编译器）。来源：page.mng。DO NOT EDIT。",
      "///|", "pub fn page() -> @widget.Node {", "  let qty : @base.Store[Int] = @base.Store::new(3)",
      "  let reg = @mngdev.mng_reg_new()", "  @mngdev.mng_reg_builtins(reg)", "  reg.expr(\"t:498fd9ec4581764e\", fn() { \"当前数量：\\{qty.get()}\" })",
      "  reg.int(\"qty\", qty)", "  @mngdev.mng_dev_page(\"page\", reg, fn() {",
      "    @ui.col([", "      @ui.stepper(qty, max=10),", "      @ui.bind_label(qty, fn(_v) { \"当前数量：\\{qty.get()}\" }),",
      "    ])", "  })", "}",
    ].join("\n") +
    "\n"
  assert_eq(code, expect)
}

///|
test "dev 形态：expr/cond/handler/state 四类登记齐（键与 IR 同口径）" {
  let code = match
    compile_dev(rich_src(), "card.mng", fn(_p : String) -> String? { None }) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(
    contains_sub(
      code, "reg.expr(\"t:415a516b3b7f7a0d\", fn() { @shared.tx(\"开\") })",
    ),
  )
  assert_true(
    contains_sub(
      code, "reg.expr(\"t:39f608ac1ab1248e\", fn() { \"数量：\\{qty.get()}\" })",
    ),
  )
  assert_true(
    contains_sub(code, "reg.cond(\"c:7ca01cd40e3676b6\", fn() { wifi.get() })"),
  )
  assert_true(contains_sub(code, "reg.handler(\"on_reset\", on_reset)"))
  assert_true(contains_sub(code, "reg.bool(\"wifi\", wifi)"))
  // 未走 v-model 的顶层 Store 也登记（受限表达式求值按名取状态）
  assert_true(contains_sub(code, "reg.int(\"qty\", qty)"))
  assert_true(contains_sub(code, "@mngdev.mng_dev_page(\"card\", reg, fn() {"))
}

