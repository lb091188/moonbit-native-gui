  let bad = compile(
    "<style>\n.bar { justify-content: middle; }\n</style>\n<template>\n  <ui-col class=\"bar\" />\n</template>",
    "layout2.mng",
  )
  assert_true(
    match bad {
      Err(e) => contains_sub(e, "不认关键字")
      _ => false
    },
  )
}

