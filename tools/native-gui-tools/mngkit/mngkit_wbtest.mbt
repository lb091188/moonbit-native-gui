// mngkit 金样测试：生成码确定性（逐字对照）、各指令落点、错误与坐标。

///|
fn t1_src() -> String {
  [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(3)", "</script>",
    "<template>", "  <ui-col>", "    <ui-stepper v-model=\"qty\" max=\"10\" />",
    "    当前数量：{{ qty }}", "  </ui-col>", "</template>",
  ].join("\n") +
  "\n"
}

///|
fn t1_expect() -> String {
  [
    "// GENERATED by mngc（native-gui 模板编译器）。来源：page.mng。DO NOT EDIT。",
    "///|", "pub fn page() -> @widget.Node {", "  let qty : @base.Store[Int] = @base.Store::new(3)",
    "  @ui.col([", "    @ui.stepper(qty, max=10),", "    @ui.bind_label(qty, fn(_v) { \"当前数量：\\{qty.get()}\" }),",
    "  ])", "}",
  ].join("\n") +
  "\n"
}

///|
test "golden：插值/值槽/静态属性逐字对照（生成码确定性的契约）" {
  let code = match compile(t1_src(), "page.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_eq(code, t1_expect())
}

///|
test "开标签属性区解析即弃：旧写法 setup/lang 与任意属性同码" {
  let with_attr = match
    compile(
      t1_src().replace(
        old="<script>",
        new="<script setup lang=\"moonbit\" data-x=\"1\">",
      ),
      "page.mng",
    ) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_eq(with_attr, t1_expect())
}

///|
test "source map：生成行 → 模板行列（步进器行、插值行）" {
  let r = match compile(t1_src(), "page.mng") {
    Ok(o) => o
    Err(e) => abort("\{e}")
  }
  // 生成第 6 行（stepper）→ 模板第 6 行；第 7 行（bind_label）→ 模板第 7 行
  assert_true(contains_sub(r.map, "6\t6\t"))
  assert_true(contains_sub(r.map, "7\t7\t"))
}

///|
fn t2_src() -> String {
  [
    "<script>", "let wifi : @base.Store[Bool] = @base.Store::new(true)", "let nick : @base.Store[String] = @base.Store::new(\"\")",
    "let err_nick = @ui.validate(nick, @ui.required())", "let sh_section = @shared.section",
    "// @mng sh-section = @shared.section positional(title, subtitle, desc, children)",
    "</script>", "<template>", "  <ui-col>", "    <ui-checkbox :label='@shared.tx(\"自动\")' v-model=\"wifi\" />",
    "    <ui-text v-if=\"wifi\" :text='@shared.tx(\"开\")' />", "    <ui-text v-else text=\"关\" />",
    "    <ui-text v-show=\"wifi\" text=\"常驻\" />", "    <ui-button text=\"清空\" @click=\"on_clear\" />",
    "    <sh-section title=\"校验\" subtitle=\"Form\" desc=\"即时\">", "      <ui-form-item label=\"昵称\">",
    "        <ui-input v-model=\"nick\" :error=\"err_nick\" placeholder=\"至少 2 个字符\" />",
    "      </ui-form-item>", "    </sh-section>", "  </ui-col>", "</template>",
  ].join("\n") +
  "\n"
}

///|
test "指令落点：v-if 链 bind_node、v-show when_bool、@click、@mng 组件、:error 直传" {
  let code = match compile(t2_src(), "t2.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  // v-if 链：全链条件并集进一个 computed，body 重判
  assert_true(
    contains_sub(
      code, "@widget.bind_node(@base.Signal::computed(fn() { wifi.get() }), fn(_v) {",
    ),
  )
  assert_true(contains_sub(code, "if wifi.get() {"))
  assert_true(contains_sub(code, "} else {"))
  // v-show → when_bool
  assert_true(
    contains_sub(
      code, "@ui.when_bool(@base.Signal::computed(fn() { wifi.get() }), @ui.text(\"常驻\"))",
    ),
  )
  // @click → on_click=函数名
  assert_true(contains_sub(code, "@ui.button(\"清空\", on_click=on_clear)"))
  // @mng 组件按 positional 展开、children 数组收尾
  assert_true(
    contains_sub(code, "@shared.section(\"校验\", \"Form\", \"即时\", ["),
  )
  // :error 直传 Store（求值一次语义）
  assert_true(
    contains_sub(
      code, "@ui.form_item(\"昵称\", @ui.input(nick, error=err_nick, placeholder=\"至少 2 个字符\"",
    ),
  )
}

///|
test "错误与坐标：未登记组件 / 孤儿 v-else / 缺 @mng 声明 / 多根 / 未闭合插值" {
  let r1 = compile(
    "<template>\n  <ui-fancy text=\"x\" />\n</template>", "a.mng",
  )
  assert_true(
    match r1 {
      Err(e) => contains_sub(e, "未登记") && contains_sub(e, "行 2")
      _ => false
    },
  )
  let r2 = compile(
    "<template>\n  <ui-col>\n    <ui-text v-else text=\"x\" />\n  </ui-col>\n</template>",
    "b.mng",
  )
  assert_true(
    match r2 {
      Err(e) => contains_sub(e, "v-else")
      _ => false
    },
  )
  let r3 = compile(
    "<script>\nlet card = @ui.panel\n</script>\n<template>\n  <card>\n    <ui-text text=\"x\" />\n  </card>\n</template>",
    "c.mng",
  )
  assert_true(
    match r3 {
      Err(e) => contains_sub(e, "positional")
      _ => false
    },
  )
  let r4 = compile(
    "<template>\n  <ui-col />\n  <ui-col />\n</template>", "d.mng",
  )
  assert_true(
    match r4 {
      Err(e) => contains_sub(e, "单根")
      _ => false
    },
  )
  let r5 = compile(
    "<template>\n  <ui-col>\n    文本 {{ qty }\n  </ui-col>\n</template>", "e.mng",
  )
  assert_true(
    match r5 {
      Err(e) => contains_sub(e, "未闭合")
      _ => false
    },
  )
  let r6 = compile(
    "<script>\nfn h() { () }\n</script>\n<template>\n  <ui-button text=\"x\" @scroll=\"h\" />\n</template>",
    "f.mng",
  )
  assert_true(
    match r6 {
      Err(e) => contains_sub(e, "@事件不支持")
      _ => false
    },
  )
}

///|
test "文本归一化：模板缩进不进生成串；多源插值走 computed" {
  let code = match
    compile(
      "<script>\nlet a : @base.Store[Int] = @base.Store::new(1)\nlet b : @base.Store[Int] = @base.Store::new(2)\n</script>\n<template>\n  <ui-col>\n    合计 {{ a }} + {{ b }}\n  </ui-col>\n</template>",
      "g.mng",
    ) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(
    contains_sub(
      code, "@ui.bind(@base.Signal::computed(fn() { \"合计 \\{a.get()} + \\{b.get()}\" }), fn(s) { s })",
    ),
  )
}

///|
test "静态属性字面量判定：裸串按字符串、单引号透传 MoonBit 表达式、数字原样" {
  let code = match
    compile(
      "<template>\n  <ui-col row_gap='8.0' grow=\"1.0\" label=\"栏\" />\n</template>",
      "h.mng",
    ) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "], row_gap=8.0, grow=1.0, label=\"栏\")"))
}

///|
test "受限表达式热更：文案/条件在文法内 HOT，并带 eval AST" {
  let base = [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(1)", "let wifi : @base.Store[Bool] = @base.Store::new(true)",
    "let nick : @base.Store[String] = @base.Store::new(\"\")", "</script>", "<template>",
    "  <ui-col>", "    <ui-text :text='@shared.tx(\"A\")' />", "    <ui-text v-if=\"wifi\" text=\"开\" />",
    "    <ui-input v-model=\"nick\" placeholder=\"x\" />", "  </ui-col>", "</template>",
  ].join("\n")
  // 文案换字面量：@shared.tx 已注册 → HOT，IR 带 eval
  let text = [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(1)", "let wifi : @base.Store[Bool] = @base.Store::new(true)",
    "let nick : @base.Store[String] = @base.Store::new(\"\")", "</script>", "<template>",
    "  <ui-col class=\"card\">", "    <ui-text :text='@shared.tx(\"B\")' />", "    <ui-text v-if=\"wifi\" text=\"开\" />",
    "    <ui-input v-model=\"nick\" placeholder=\"x\" />", "  </ui-col>", "</template>",
  ].join("\n")
  let ir = match hot_ir(text, base, "p.mng") {
    Ok(j) => j
    Err(e) => abort("文案热更应通过：\{e}")
  }
  assert_true(contains_sub(ir, "\"class\":[\"card\"]"))
  assert_true(contains_sub(ir, "\"eval\":{"))
  assert_true(contains_sub(ir, "\"call\""))
  // 条件换成 qty > 5：Store 已登记 → HOT
  let cond = [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(1)", "let wifi : @base.Store[Bool] = @base.Store::new(true)",
    "let nick : @base.Store[String] = @base.Store::new(\"\")", "</script>", "<template>",
    "  <ui-col>", "    <ui-text :text='@shared.tx(\"A\")' />", "    <ui-text v-if=\"qty > 5\" text=\"开\" />",
    "    <ui-input v-model=\"nick\" placeholder=\"x\" />", "  </ui-col>", "</template>",
  ].join("\n")
  match hot_ir(cond, base, "p.mng") {
    Ok(_) => ()
    Err(e) => abort("条件热更应通过：\{e}")
  }
  // 文法外：新函数 / 新符号 / script 与 <style> 改动都转 COLD
  let bad_call = text.replace(
    old="@shared.tx(\"B\")",
    new="@shared.nope(\"B\")",
  )
  assert_true(
    match hot_ir(bad_call, base, "p.mng") {
      Err(e) => contains_sub(e, "白名单")
      _ => false
    },
  )
  let bad_id = text.replace(old="@shared.tx(\"B\")", new="@shared.tx(missing)")
  assert_true(
    match hot_ir(bad_id, base, "p.mng") {
      Err(e) => contains_sub(e, "未登记")
      _ => false
    },
  )
  let bad_script = base.replace(old="Store::new(1)", new="Store::new(2)")
  assert_true(
    match hot_ir(bad_script, base, "p.mng") {
      Err(e) => contains_sub(e, "script")
      _ => false
    },
  )
  let styled = base.replace(
    old="<template>",
    new="<style>\n.card { color: var(--text_primary); }\n</style>\n<template>",
  )
  match hot_ir(styled, base, "p.mng") {
    Ok(ir) => {
      assert_true(contains_sub(ir, "\"classes\":[{\"n\":\"card\""))
      assert_true(contains_sub(ir, "\"p\":\"color\""))
    }
    Err(e) => abort("<style> 改动应随类数据热更：\{e}")
  }
}

///|
test "样式数据：<style> 规则编成 p/e 对（应用侧按名字段）" {
  let json = match
    style_classes_json(
      ".a { font-size: 20px; color: var(--text_primary); justify-content: center; }\n.a:hover { color: var(--primary); }",
      0,
    ) {
    Ok(v) => v
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(json, "\"n\":\"a\""))
  assert_true(contains_sub(json, "\"p\":\"font_size\",\"e\":\"20.0\""))
  assert_true(
    contains_sub(json, "\"p\":\"color\",\"e\":\"\\\"text_primary\\\"\""),
  )
  assert_true(
    contains_sub(
      json, "\"p\":\"justify_content\",\"e\":\"@yoga.JustifyContent::Center\"",
    ),
  )
  assert_true(contains_sub(json, "\"s\":\"hover\""))
}

///|
test "受限表达式：文本插值改动也在文法内 HOT" {
  let base = [
    "<script>", "let qty : @base.Store[Int] = @base.Store::new(1)", "</script>",
    "<template>", "  <ui-text>数量：{{ qty }}</ui-text>", "</template>",
