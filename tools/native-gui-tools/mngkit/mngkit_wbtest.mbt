///|
test "样式章：CSS 子集——只认规范属性名与值形态" {
  let base = fn(body : String) -> String {
    "<style>\n.a { " +
    body +
    " }\n</style>\n<template>\n  <ui-col class=\"a\" />\n</template>"
  }
  let ok = fn(body : String) -> String {
    match compile(base(body), "css.mng") {
      Ok(o) => o.code
      Err(e) => abort("\{e}")
    }
  }
  let bad = fn(body : String, hint : String) -> Bool {
    match compile(base(body), "css.mng") {
      Err(e) => contains_sub(e, hint)
      Ok(_) => false
    }
  }
  // 非 CSS 属性名不再出现在模板面（运行时字段仍在）
  assert_true(bad("width-percent: 100;", "不是 Style 属性"))
  assert_true(bad("height-percent: 50;", "不是 Style 属性"))
  assert_true(bad("transition-ms: 120;", "不是 Style 属性"))
  // 长度要单位，零可省略
  assert_true(bad("padding: 8;", "要像素长度"))
  assert_true(bad("font-size: 14;", "要像素长度"))
  let zero = ok("padding: 0;")
  assert_true(contains_sub(zero, "padding=0.0"))
  let px = ok("padding: 8px;")
  assert_true(contains_sub(px, "padding=8.0"))
  // 字重按 CSS 数值/关键字
  assert_true(
    contains_sub(ok("font-weight: 700;"), "font_weight=@text.FontWeight::Bold"),
  )
  assert_true(
    contains_sub(ok("font-weight: bold;"), "font_weight=@text.FontWeight::Bold"),
  )
  assert_true(bad("font-weight: thin;", "不认关键字"))
  // cursor 收 CSS 关键字
  assert_true(contains_sub(ok("cursor: pointer;"), "cursor=1"))
  assert_true(bad("cursor: 2;", "只认 default / pointer / text"))
  // 过渡用 CSS 名字 + 毫秒
  assert_true(
    contains_sub(ok("transition-duration: 120ms;"), "transition_ms=120.0"),
  )
  assert_true(bad("transition-duration: .12s;", "要毫秒"))
  // flex 的 grow/shrink 是无单位数，basis 是长度/百分比
  assert_true(contains_sub(ok("flex: 1;"), "flex=1.0"))
  assert_true(bad("flex: 1px;", "无单位数"))
}

///|
test "sig_params：参数表带默认值与参数级文档" {
  let sig = [
    "pub fn f(", "  a : Int,", "  /// 占位文字，未输入时显示。", "  b? : String = \"\",",
    ") -> Int {",
  ].join("\n")
  let ps = sig_params(sig)
  assert_eq(ps.length(), 2)
  assert_eq(ps[0].0, "a")
  assert_eq(ps[0].4, "")
  assert_eq(ps[1].0, "b")
  assert_eq(ps[1].2, true)
  assert_eq(ps[1].3, "\"\"")
  assert_eq(ps[1].4, "占位文字，未输入时显示。")
}

///|
/// 语义分词：取令牌覆盖的原文（夹具全 BMP，字符下标即码元下标）。
fn sem_text_at(src : String, t : SemTok) -> String {
  let a = chars_of(src)
  slice_str(a, t.start, t.start + t.len)
}

///|
/// 语义分词：第一个覆盖原文为 `text` 的令牌。
fn sem_find_tok(src : String, toks : Array[SemTok], text : String) -> SemTok? {
  for t in toks {
    if sem_text_at(src, t) == text {
      return Some(t)
    }
  }
  None
}

///|
/// 语义分词：覆盖原文为 `text` 的全部令牌是否都落在给定档位。
fn sem_all_ty(
  src : String,
  toks : Array[SemTok],
  text : String,
  ty : Int32,
) -> Bool {
  let mut seen = false
  for t in toks {
    if sem_text_at(src, t) == text {
      seen = true
      if t.ty != ty {
        return false
      }
    }
  }
  seen
}

///|
fn sem_fixture() -> String {
  [
    "<script>", "fn page(limit : Int) -> @widget.Node", "let qty : @base.Store[Int] = @base.Store::new(3)",
    "fn bump(x : Int) -> Int { qty.set(x) }", "let msg = \"共 \\{qty} 个\"", "</script>",
    "<template>", "  <ui-stepper v-model=\"qty\" :max=\"limit\" />", "  <ui-button text=\"重置\" @click=\"bump\" />",
    "</template>",
  ].join("\n") +
  "\n"
}

///|
test "semantic：类型/变量/参数/函数/方法/命名空间分档与修饰位" {
  let src = sem_fixture()
  let toks = semantic_tokens(src)
  // let 绑定声明：variable + declaration + readonly；引用处 variable + readonly
  let q = sem_find_tok(src, toks, "qty")
  assert_true(q is Some(_))
  assert_eq(q.unwrap().ty, 8) // variable
  assert_eq(q.unwrap().mods, 5) // declaration | readonly
  assert_true(sem_all_ty(src, toks, "qty", 8))
  // props 参数与 fn 签名参数：parameter
  assert_true(sem_all_ty(src, toks, "limit", 7))
  let l = sem_find_tok(src, toks, "limit")
  assert_eq(l.unwrap().mods, 1) // declaration
  assert_true(sem_all_ty(src, toks, "x", 7))
  // 类型（含成员链上的 @base.Store 与泛型 Int / 返回 Node）
  assert_true(sem_all_ty(src, toks, "Store", 1))
  assert_true(sem_all_ty(src, toks, "Int", 1))
  assert_true(sem_all_ty(src, toks, "Node", 1))
  // 命名空间（@base / @widget）
  assert_true(sem_all_ty(src, toks, "@base", 0))
  assert_true(sem_all_ty(src, toks, "@widget", 0))
  // :: 后与调用形态 → function；fn 声明名带 declaration
  assert_true(sem_all_ty(src, toks, "new", 12))
  assert_true(sem_all_ty(src, toks, "bump", 12))
  let b = sem_find_tok(src, toks, "bump")
  assert_eq(b.unwrap().mods, 1)
  // 方法调用 .set(
  assert_true(sem_all_ty(src, toks, "set", 13))
  // 字符串插值里的状态名也分档
  assert_eq(sem_find_tok(src, toks, "msg").unwrap().mods, 5)
  // 纯文本属性值不发语义令牌
  assert_true(sem_find_tok(src, toks, "重置") is None)
}

///|
test "semantic：let mut 无 readonly、成员访问 property、残缺文档不炸" {
  let src = [
      "<script>", "fn page(n : Int) -> @widget.Node", "let mut count = 0", "let label = \"x\"",
      "let n2 = count.length", "</script>", "<template>", "  <ui-text :text=\"label\" />",
      "</template>",
    ].join("\n") +
    "\n"
  let toks = semantic_tokens(src)
  let c = sem_find_tok(src, toks, "count")
  assert_eq(c.unwrap().ty, 8)
  assert_eq(c.unwrap().mods, 1) // mut：无 readonly
  let lb = sem_find_tok(src, toks, "label")
  assert_eq(lb.unwrap().mods, 5)
  // 成员引用不带调用 → property
  assert_true(sem_all_ty(src, toks, "length", 9))
  // 残缺文档：无 script / 未闭合 template，不抛错
  assert_true(semantic_tokens("<template><ui-col>").length() >= 0)
  assert_eq(semantic_tokens("").length(), 0)
}

///|
test "semantic：插值后的标签不再被吞（}} 停止界回归）" {
  let src = [
      "<script>", "let qty : @base.Store[Int] = @base.Store::new(3)", "</script>",
      "<template>", "  当前数量：{{ qty }}", "  <ui-input v-model=\"qty\" />",
      "</template>",
    ].join("\n") +
    "\n"
  let toks = semantic_tokens(src)
  // let 声明 + 插值 + v-model 共三处 qty，缺一即扫描跑穿
  assert_eq(toks.filter(fn(t) { sem_text_at(src, t) == "qty" }).length(), 3)
}

///|
test "source map 正向索引：源位置→生成行，反查也能回投" {
  let map = [
    "# mng source map v1", "source demo.mng", "6\t12\t1", "7\t12\t9", "8\t14\t3",
    "12\t20\t5",
  ].join("\n")
  // 12 行有两段：col 1 与 col 9 各一条，取「≤ 目标」里最靠后的一条
  assert_eq(src_to_gen(map, 12, 1), Some((6, 1)))
  assert_eq(src_to_gen(map, 12, 9), Some((7, 1)))
  assert_eq(src_to_gen(map, 12, 15), Some((7, 7)))
  assert_eq(src_to_gen(map, 13, 1), Some((7, 1)))
  assert_eq(src_to_gen(map, 14, 3), Some((8, 1)))
  assert_eq(src_to_gen(map, 20, 6), Some((12, 2)))
  // 早于第一条记录：没有可投的位置
  assert_eq(src_to_gen(map, 1, 1), None)
  // 反查：同一生成行以最后一条为准
  assert_eq(gen_to_src(map, 7), Some((12, 9)))
  assert_eq(gen_to_src(map, 8), Some((14, 3)))
  assert_eq(gen_to_src(map, 99), None)
  // 坏行/表头不算数
  let dirty = ["# x", "abc", "1\t2", "3\t4\t5"].join("\n")
  assert_eq(src_to_gen(dirty, 4, 5), Some((3, 1)))
}

///|
fn tfor_src() -> String {
  [
    "<script>", "let rows : @base.ListStore[@base.Item] = @base.ListStore::new()",
    "</script>", "<template>", "  <ui-col>", "    <ui-row v-for=\"r in rows\" :key=\"r.id\">",
    "      <ui-text :text=\"r.name\" />", "    </ui-row>", "  </ui-col>", "</template>",
  ].join("\n") +
  "\n"
}

///|
test "v-for：ListStore 源 + :key → for_list keyed，行内表达式不当槽" {
  let code = match compile(tfor_src(), "tfor.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "@ui.for_list(rows, fn(r, _i) {"))
  assert_true(contains_sub(code, "@ui.text(r.name)"))
  assert_true(contains_sub(code, "}, key=fn(r) { r.id })"))
  // 行内没有响应源，不出 bind 行
  assert_false(contains_sub(code, "bind_label"))
}

///|
test "v-for：无 :key 走 for_list_indexed；(别名, 下标) 且下标被引用保原名" {
  let src = [
      "<script>", "let rows : @base.ListStore[@base.Item] = @base.ListStore::new()",
      "</script>", "<template>", "  <ui-col>", "    <ui-row v-for=\"(r, i) in rows\">",
      "      <ui-text :text=\"i.to_string() + r.name\" />", "    </ui-row>", "  </ui-col>",
      "</template>",
    ].join("\n") +
    "\n"
  let code = match compile(src, "tfor2.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "@ui.for_list_indexed(rows, fn(r, i) {"))
  assert_true(contains_sub(code, "@ui.text(i.to_string() + r.name)"))
  // 下标别名给了但没被引用：垫 _ 前缀保零警告
  let src2 = [
      "<script>", "let rows : @base.ListStore[@base.Item] = @base.ListStore::new()",
      "</script>", "<template>", "  <ui-col>", "    <ui-row v-for=\"(r, i) in rows\">",
      "      <ui-text :text=\"r.name\" />", "    </ui-row>", "  </ui-col>", "</template>",
    ].join("\n") +
    "\n"
  let code2 = match compile(src2, "tfor3.mng") {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code2, "fn(r, _i) {"))
}

///|
test "v-for 错误面：Store 源 / 非 Slot / :key 孤儿 / v-for+v-if / 嵌套" {
  let store_src = [
      "<script>", "let rows : @base.Store[Int] = @base.Store::new(0)", "</script>",
      "<template>", "  <ui-col>", "    <ui-row v-for=\"x in rows\" />", "  </ui-col>",
      "</template>",
    ].join("\n") +
    "\n"
  assert_true(
    match compile(store_src, "e1.mng") {
      Err(e) => contains_sub(e, "ListStore")
      _ => false
    },
  )
  let plain_src = [
      "<script>", "let name : String = \"x\"", "</script>", "<template>", "  <ui-col>",
      "    <ui-row v-for=\"x in name\" />", "  </ui-col>", "</template>",
    ].join("\n") +
    "\n"
  assert_true(
    match compile(plain_src, "e2.mng") {
      Err(e) => contains_sub(e, "不是响应槽")
      _ => false
    },
  )
  let orphan_key = "<template>\n  <ui-col>\n    <ui-text :key=\"a.id\" text=\"x\" />\n  </ui-col>\n</template>"
  assert_true(
    match compile(orphan_key, "e3.mng") {
      Err(e) => contains_sub(e, ":key")
      _ => false
    },
  )
  let with_if = [
      "<script>", "let rows : @base.ListStore[@base.Item] = @base.ListStore::new()",
      "let on : @base.Store[Bool] = @base.Store::new(true)", "</script>", "<template>",
      "  <ui-col>", "    <ui-row v-for=\"r in rows\" v-if=\"on\" />", "  </ui-col>",
      "</template>",
    ].join("\n") +
    "\n"
  assert_true(
    match compile(with_if, "e4.mng") {
      Err(e) => contains_sub(e, "v-if")
      _ => false
    },
  )
  let nested = [
      "<script>", "let rows : @base.ListStore[@base.Item] = @base.ListStore::new()",
      "</script>", "<template>", "  <ui-col>", "    <ui-col v-for=\"r in rows\">",
      "      <ui-text v-for=\"t in r.name\" />", "    </ui-col>", "  </ui-col>",
      "</template>",
    ].join("\n") +
    "\n"
  assert_true(
    match compile(nested, "e5.mng") {
      Err(e) => contains_sub(e, "裸标识符")
      _ => false
    },
  )
}

///|
test "v-for dev 档：行子树不进注册表；hot_ir 直接回 Err 转 COLD" {
  let code = match
    compile_dev(tfor_src(), "tfor.mng", fn(_p : String) -> String? { None }) {
    Ok(o) => o.code
    Err(e) => abort("\{e}")
  }
  assert_true(contains_sub(code, "@ui.for_list(rows, fn(r, _i) {"))
  // 行内表达式（引用行作用域别名）不进注册表
  assert_false(contains_sub(code, "fn() { r.name }"))
  match hot_ir(tfor_src(), tfor_src(), "tfor.mng") {
    Err(e) => assert_true(contains_sub(e, "v-for"))
    Ok(_) => assert_true(false, msg="含 v-for 的模板应当回 COLD")
  }
}
