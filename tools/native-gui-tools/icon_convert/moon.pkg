// iconfont 转化 CLI（终端形态）：受众是 AI / prebuild / CI，非交互、无界面。
// 文件 I/O 走官方 moonbitlang/x（fs/sys），本包不含自写 C、不进 prebuild link 面。
import {
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
  "NoahLiu/native-gui-tools/iconkit",
}

pkgtype(kind: "executable")

supported_targets = "native"

// -lpthread：本包不吃 prebuild 的系统库尾巴（GUI 链已带），MoonBit 运行时的
// mimalloc 引用 pthread 一族；glibc 2.34 以前 pthread 是独立库，缺它必断链
// （deepin 20.9 实测），2.34 起并进 libc，多传无害。
options(
  link: {
    "native": {
      "cc-link-flags": "-lpthread",
    },
  },
)
